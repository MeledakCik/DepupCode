<UserControl x:Class="DepupCode.Views.ExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeEditorBrush}">
  <UserControl.Resources>
    <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <Style x:Key="ExtensionTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="TabSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="TabLine" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/></Trigger>
              <Trigger Property="Tag" Value="Selected"><Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/><Setter TargetName="TabLine" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ExtensionListBoxItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorderLightBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeActiveNavBrush}"/>
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ExtensionMenuOption" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="OptionSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DetailMetaLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeDimBrush}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DetailMetaValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource ThemeActivityBrush}" BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,16,24,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Extensions" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="Cari dan pasang tema warna atau snippets untuk Depup Code." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,5" VerticalAlignment="Center" Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource BrandLime}" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock Text="Open VSX · registry terbuka" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="9.5" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Search + category + action -->
    <Grid Grid.Row="1" Margin="24,14,24,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource ThemeInputBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" CornerRadius="8" Height="38" MinWidth="180">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Path Grid.Column="0" Data="M6.5,1.5 A5,5 0 1 0 6.5,11.5 A5,5 0 1 0 6.5,1.5 M10.4,10.4 L15,15"
                Stroke="{DynamicResource ThemeMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Width="16" Height="16" Stretch="Uniform" Margin="12,0,8,0" VerticalAlignment="Center"/>
          <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,0,8,0"
                   FontSize="11" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown" ToolTip="Cari extension di Open VSX"/>
          <TextBlock Grid.Column="1" Text="Cari ekstensi berdasarkan nama, penerbit, atau tag…" IsHitTestVisible="False"
                     Foreground="{DynamicResource ThemeDimBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button x:Name="ClearSearchButton" Grid.Column="2" Width="28" Height="26" Margin="0,0,4,0" Padding="0"
                  Background="Transparent" BorderThickness="0" Click="ClearSearch_Click" ToolTip="Hapus kata kunci" AutomationProperties.Name="Hapus kata kunci">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource ThemeMutedBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </Grid>
      </Border>

      <ComboBox x:Name="CategoryCombo" Grid.Column="1" Width="168" Height="38" Margin="10,0,0,0" FontSize="10.5"
                VerticalContentAlignment="Center" SelectionChanged="CategoryCombo_SelectionChanged"
                ToolTip="Filter kategori extension" AutomationProperties.Name="Filter kategori extension">
        <ComboBoxItem Content="Semua extension" Tag="all" IsSelected="True"/>
        <ComboBoxItem Content="Tema, snippets &amp; Node.js" Tag="compatible"/>
        <ComboBoxItem Content="Tema" Tag="Themes"/>
        <ComboBoxItem Content="Snippets" Tag="Snippets"/>
        <ComboBoxItem Content="Runtime Node.js" Tag="Activation"/>
      </ComboBox>

      <Button Grid.Column="2" Content="Cari" Click="Search_Click" Margin="10,0,0,0" Height="38" MinWidth="80"
              Style="{StaticResource PrimaryButton}" ToolTip="Cari extension di Open VSX (Enter)"/>
    </Grid>

    <!-- Tabs + result status -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BrowseTab" Content="Jelajahi" Tag="Selected" Style="{StaticResource ExtensionTabButton}" Click="Browse_Click"/>
          <Button x:Name="InstalledTab" Content="Terpasang" Style="{StaticResource ExtensionTabButton}" Click="Installed_Click"/>
        </StackPanel>
        <TextBlock x:Name="ResultStatus" DockPanel.Dock="Right" Text="Siap mencari" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9.5" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- List + details -->
    <Grid Grid.Row="3" Margin="24,12,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="260" MaxWidth="420"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="1.9*" MinWidth="340"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
        <ListBox x:Name="ExtensionList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ExtensionListBoxItem}"
                 SelectionChanged="ExtensionList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource ThemeActiveSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" VerticalAlignment="Top" ClipToBounds="True">
                  <Grid>
                    <TextBlock Text="{Binding IconText}" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Publisher}" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="9.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="{DynamicResource ThemeDimBrush}" FontSize="8.5" HorizontalAlignment="Right"/>
                  <Border Background="{DynamicResource ThemeActiveSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5,2" Margin="0,6,0,0" HorizontalAlignment="Right">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="✓" Foreground="{DynamicResource BrandLime}" FontSize="8" Margin="0,0,3,0"/>
                      <TextBlock Text="Terpasang" Foreground="{DynamicResource BrandLime}" FontSize="8"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10">
        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Padding="24,22,24,24">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="72" Height="72" Background="{DynamicResource ThemeActiveSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" CornerRadius="16" VerticalAlignment="Top" ClipToBounds="True">
                <Grid>
                  <TextBlock x:Name="DetailIcon" Text="◇" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image x:Name="DetailImage" Stretch="UniformToFill"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="16,1,0,0">
                <TextBlock x:Name="DetailTitle" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap">
                  <Run x:Name="DetailTitleRun" Text="Pilih extension"/>
                  <InlineUIContainer BaselineAlignment="Center">
                    <Border x:Name="VerifiedBadge" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource ThemeAccentBrush}" Margin="8,0,0,0" ToolTip="Terdaftar di Open VSX" AutomationProperties.Name="Terdaftar di Open VSX">
                      <TextBlock Text="✓" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </InlineUIContainer>
                </TextBlock>
                <TextBlock x:Name="DetailPublisher" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailDescription" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>

            <WrapPanel Margin="0,14,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="0,0,10,4" VerticalAlignment="Center">
                <Path Data="M8,2 L8,11 M4,7.5 L8,11.5 L12,7.5 M3,14 L13,14"
                      Stroke="{DynamicResource ThemeAccentSoftBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="DetailDownloads" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="9.5" VerticalAlignment="Center"/>
              </StackPanel>
              <Border x:Name="CategoryBadge" Background="{DynamicResource ThemeActiveSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8,3" Margin="0,0,6,4" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="DetailCategory" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="9"/>
              </Border>
            </WrapPanel>

            <WrapPanel Margin="0,16,0,0">
              <Button x:Name="InstallButton" Content="Pasang" MinWidth="104" Height="34" Click="Install_Click" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="ActivateButton" Content="Aktifkan" MinWidth="104" Height="34" Margin="8,0,0,0" Click="Activate_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="DeactivateButton" Content="Nonaktifkan" MinWidth="104" Height="34" Margin="8,0,0,0" Click="Deactivate_Click" Visibility="Collapsed"/>
              <Button x:Name="UseThemeButton" Content="Pakai Tema" MinWidth="104" Height="34" Margin="8,0,0,0" Click="UseTheme_Click" Visibility="Collapsed"/>
              <Button x:Name="MoreButton" Content="⋯" Width="38" Height="34" Margin="8,0,0,0" Padding="0" FontSize="14"
                      Click="More_Click" ToolTip="Tindakan lainnya" AutomationProperties.Name="Tindakan extension lainnya"/>
            </WrapPanel>

            <ComboBox x:Name="ThemeChoiceBox" Width="250" HorizontalAlignment="Left" Height="32" Margin="0,12,0,0" Visibility="Collapsed"
                      DisplayMemberPath="Name" ToolTip="Pilih tema dari extension ini"/>

            <Border Background="{DynamicResource ThemeActiveSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,18,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="M9,1 L16,4 L16,9 C16,13 13,15.5 9,17 C5,15.5 2,13 2,9 L2,4 Z"
                      Stroke="{DynamicResource ThemeAccentSoftBrush}" StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"
                      Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,10,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Keamanan &amp; kompatibilitas" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CompatibilityText" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15"/>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="IKHTISAR FITUR" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="0,22,0,9"/>
            <StackPanel x:Name="FeatureList"/>

            <TextBlock Text="INFORMASI PAKET" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="0,20,0,9"/>
            <Border Background="{DynamicResource ThemeActiveSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,4">
              <StackPanel>
                <Grid Margin="0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Identifier" Style="{StaticResource DetailMetaLabel}" Margin="0"/>
                  <TextBlock x:Name="MetaIdentifier" Grid.Column="1" Style="{StaticResource DetailMetaValue}" FontFamily="{StaticResource Mono}"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource ThemeSeparatorBrush}"/>
                <Grid Margin="0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Versi" Style="{StaticResource DetailMetaLabel}" Margin="0"/>
                  <TextBlock x:Name="MetaVersion" Grid.Column="1" Style="{StaticResource DetailMetaValue}"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource ThemeSeparatorBrush}"/>
                <Grid Margin="0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Penerbit" Style="{StaticResource DetailMetaLabel}" Margin="0"/>
                  <TextBlock x:Name="MetaPublisher" Grid.Column="1" Style="{StaticResource DetailMetaValue}"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource ThemeSeparatorBrush}"/>
                <Grid Margin="0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Kategori" Style="{StaticResource DetailMetaLabel}" Margin="0"/>
                  <TextBlock x:Name="MetaCategories" Grid.Column="1" Style="{StaticResource DetailMetaValue}"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource ThemeSeparatorBrush}"/>
                <Grid Margin="0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Sumber" Style="{StaticResource DetailMetaLabel}" Margin="0"/>
                  <TextBlock x:Name="MetaSource" Grid.Column="1" Style="{StaticResource DetailMetaValue}"/>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="Extension dipasang dari Open VSX. Depup Code tidak menjalankan kode aktivasi VS Code tanpa persetujuan Anda."
                       Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="14"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="EmptyState" Grid.ColumnSpan="3" Background="{DynamicResource ThemeEditorBrush}" Visibility="Collapsed" CornerRadius="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
          <TextBlock x:Name="EmptyStateTitle" Text="Memuat Extensions…" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyStateMessage" Text="Hubungkan ke Open VSX untuk menjelajahi extension." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="8,6,8,0" LineHeight="16"/>
        </StackPanel>
      </Border>

      <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="{DynamicResource ThemePopupBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="196" Margin="0,5,0,0">
          <StackPanel>
            <TextBlock Text="TINDAKAN EXTENSION" Foreground="{DynamicResource ThemeDimBrush}" FontSize="8" FontWeight="Bold" Margin="10,5,8,4"/>
            <Button x:Name="OpenRegistryButton" Content="Buka di Open VSX" Style="{StaticResource ExtensionMenuOption}" Click="OpenRegistry_Click"/>
            <Button x:Name="CopyIdentifierButton" Content="Salin ID extension" Style="{StaticResource ExtensionMenuOption}" Click="CopyIdentifier_Click"/>
            <Border x:Name="UninstallSeparator" Height="1" Background="{DynamicResource ThemeSeparatorBrush}" Margin="6,4"/>
            <Button x:Name="UninstallButton" Content="Hapus extension" Style="{StaticResource ExtensionMenuOption}" Click="Uninstall_Click" Foreground="{DynamicResource ThemeAccentSoftBrush}"/>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Grid>
</UserControl>
