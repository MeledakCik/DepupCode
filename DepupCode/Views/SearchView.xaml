<UserControl x:Class="DepupCode.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DepupCode.Views"
             Background="{DynamicResource ThemePopupBrush}">
  <UserControl.Resources>
    <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Code, Consolas</FontFamily>
    <Style x:Key="OptionToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="22"/><Setter Property="Margin" Value="1,0"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}"/><Setter Property="FontFamily" Value="{StaticResource Mono}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeActiveSurfaceBrush}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FlatInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLightBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="12,11,12,8">
      <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeActiveSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="7,1">
        <TextBlock Text="in workspace" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="9" FontWeight="SemiBold" FontFamily="{StaticResource Mono}"/>
      </Border>
      <TextBlock Text="SEARCH" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
    </DockPanel>

    <Border Grid.Row="1" Margin="10,0,10,6" Background="{DynamicResource ThemeInputBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" CornerRadius="6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
          <ToggleButton x:Name="CaseToggle" Content="Aa" Style="{StaticResource OptionToggle}" ToolTip="Match case" Click="Option_Changed"/>
          <ToggleButton x:Name="WordToggle" Content="ab|" Style="{StaticResource OptionToggle}" ToolTip="Match whole word" Click="Option_Changed"/>
          <ToggleButton x:Name="RegexToggle" Content=".*" Style="{StaticResource OptionToggle}" ToolTip="Use regular expression" Click="Option_Changed"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Left" Text="⌕" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="15" Margin="9,0,2,2" VerticalAlignment="Center"/>
        <TextBox x:Name="QueryBox" BorderThickness="0" Background="Transparent" Padding="4,6" FontFamily="{StaticResource Mono}" FontSize="12"
                 VerticalContentAlignment="Center" KeyDown="Query_KeyDown" ToolTip="Cari teks di dalam file project (Enter)"/>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="2" Margin="10,0,10,4">
      <DockPanel Margin="2,2,2,4" Cursor="Hand" MouseLeftButtonUp="ToggleFilters">
        <TextBlock DockPanel.Dock="Right" Text="Enter untuk mencari" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" VerticalAlignment="Center"/>
        <TextBlock x:Name="FilterArrow" Text="⌄" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <TextBlock Text="Filter file" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel x:Name="FilterPanel" Visibility="Collapsed">
        <Border Height="1" Background="{DynamicResource ThemeSeparatorBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="IncludeBox" Style="{StaticResource FlatInput}" Margin="0,0,0,5" KeyDown="Query_KeyDown" ToolTip="Include, pisahkan dengan koma. Contoh: *.ts, src/**"/>
        <TextBlock Text="Termasuk · *.ts, src/**" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" Margin="2,-2,0,5"/>
        <TextBox x:Name="ExcludeBox" Style="{StaticResource FlatInput}" Margin="0,0,0,5" KeyDown="Query_KeyDown" ToolTip="Exclude, pisahkan dengan koma. Contoh: *.min.js, dist/**"/>
        <TextBlock Text="Kecualikan · *.min.js, dist/**" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" Margin="2,-2,0,5"/>
      </StackPanel>
    </StackPanel>

    <DockPanel Grid.Row="3" Margin="12,2,12,6">
      <TextBlock x:Name="FolderText" DockPanel.Dock="Right" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontFamily="{StaticResource Mono}" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis" Text="Masukkan kata lalu tekan Enter."/>
    </DockPanel>

    <TreeView x:Name="ResultsTree" Grid.Row="4" Margin="4,0,2,6" SelectedItemChanged="Result_Selected">
      <TreeView.Resources>
        <HierarchicalDataTemplate DataType="{x:Type views:FileGroup}" ItemsSource="{Binding Hits}">
          <DockPanel MinWidth="200" Height="24" LastChildFill="True">
            <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeActiveSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" MinWidth="18" Padding="5,0" Margin="6,0,6,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Count}" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource Mono}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="◆" Foreground="#F59E0B" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}">
              <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource ThemePrimaryBrush}"/>
              <Run Text="{Binding Directory, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{DynamicResource ThemeDimBrush}"/>
            </TextBlock>
          </DockPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type views:LineHit}">
          <DockPanel MinWidth="200" Height="21">
            <TextBlock Text="{Binding Line}" DockPanel.Dock="Left" Width="30" TextAlignment="Right" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock views:HitText.Hit="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource ThemeSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
        </DataTemplate>
      </TreeView.Resources>
    </TreeView>
  </Grid>
</UserControl>
