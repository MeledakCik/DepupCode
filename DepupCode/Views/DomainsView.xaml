<UserControl x:Class="DepupCode.Views.DomainsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeWindowBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24" MaxWidth="1250" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header banner with a simple domain globe mark. -->
      <Border Grid.Row="0" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="50" Height="50" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" Background="{DynamicResource ThemeSurfaceBrush}" Margin="0,0,16,0">
            <Viewbox Width="27" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M12,21 A9,9 0 1,1 12,3 A9,9 0 1,1 12,21 Z M3.6,9 L20.4,9 M3.6,15 L20.4,15 M12,3 C9.5,7 9.5,17 12,21 M12,3 C14.5,7 14.5,17 12,21"
                      Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"/>
              </Canvas>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Domains &amp; URLs" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryBrush}"/>
              <Border Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="#4B3A93" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="11,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="WORKSPACE LINKS" Foreground="#C4B5FD" FontSize="9" FontWeight="Bold" FontFamily="JetBrains Mono, Cascadia Code, Consolas"/>
              </Border>
            </StackPanel>
            <TextBlock Text="Deployment URLs saved in your Offline-First cache and synced with Depup Cloud." Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Content="＋ Tambah Domain" Tag="RequiresCloud" Click="AddDomain_Click" Margin="0,0,8,0"/>
            <Button Content="Kelola di Depup Cloud ↗" Tag="RequiresCloud" Style="{StaticResource PrimaryButton}" Click="ManageDomains_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Address Count & Search Bar (Fixed DockPanel order so text NEVER collides) -->
      <Border Grid.Row="1" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
        <DockPanel LastChildFill="True">
          <TextBox x:Name="DomainSearchBox" DockPanel.Dock="Right" Width="250" Height="32" VerticalContentAlignment="Center"
                   TextChanged="DomainSearch_TextChanged" ToolTip="Filter nama domain, URL, atau platform..."/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="SAVED DEPLOYMENT ADDRESSES" Foreground="#C4B5FD" FontSize="10.5" FontWeight="Bold" FontFamily="JetBrains Mono, Cascadia Code, Consolas" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
              <TextBlock x:Name="StatusText" Foreground="#34D399" FontSize="10" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Clean Dark Domain Cards List (Explicit ItemContainerStyle eliminates white ListBoxItem wrapper) -->
      <ItemsControl x:Name="DomainsList" Grid.Row="2" HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <Border Background="#0F2A22" BorderBrush="#1E5A45" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                      <TextBlock Text="TLS 1.3 Active" Foreground="#34D399" FontSize="9" FontFamily="JetBrains Mono, Cascadia Code, Consolas"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding SiteUrl}" Foreground="#C4B5FD" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="12" Margin="17,6,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" Margin="17,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button Content="Copy URL" Padding="11,6" Click="Copy_Click" Margin="0,0,7,0"/>
                  <Button Content="Open Site ↗" Tag="RequiresCloud" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="Open_Click"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Grid.Row="3" Text="Daftar ini menggabungkan URL deployment di cache Offline-First lokal dan domain tersimpan di akun Depup Cloud." Foreground="{DynamicResource ThemeDimBrush}" FontSize="10.5" Margin="2,6,0,0" TextWrapping="Wrap"/>
    </Grid>
  </ScrollViewer>
</UserControl>
