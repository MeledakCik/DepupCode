<UserControl x:Class="DepupCode.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource ThemeWindowBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource ThemePanelBrush}">
      <Button DockPanel.Dock="Right" Content="✕  Tutup diff" Style="{StaticResource GhostButton}" Padding="10,2" Margin="0,5,8,5" FontSize="11" Click="Close_Click"/>
      <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" FontFamily="JetBrains Mono, Cascadia Code, Consolas" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <Border Background="{DynamicResource ThemeHoverBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="0,2,0,0" Padding="14,0" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="FileTag" Foreground="#60A5FA" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Cascadia Code, Consolas" Margin="0,0,8,0"/>
          <TextBlock x:Name="FileTitle" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
          <Border Background="#4B3A93" CornerRadius="4" Padding="6,1" Margin="9,0,0,0"><TextBlock x:Name="ModeBadge" Text="Working Tree" Foreground="#E4E4F4" FontSize="9" FontWeight="SemiBold"/></Border>
        </StackPanel>
      </Border>
      <TextBlock x:Name="PathText" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" FontFamily="JetBrains Mono, Cascadia Code, Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>

    <Border Grid.Row="1" Grid.Column="0" Background="#3A1520" BorderBrush="#5A2030" BorderThickness="0,0,0,1" Padding="12,0">
      <DockPanel>
        <TextBlock x:Name="LeftSub" DockPanel.Dock="Right" Foreground="#F9A8B8" FontSize="10" FontFamily="JetBrains Mono, Cascadia Code, Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="HEAD (Index - Previous commit)" Foreground="#FECACA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource ThemeBorderBrush}"/>
    <Border Grid.Row="1" Grid.Column="2" Background="#0F2A22" BorderBrush="#1E5A45" BorderThickness="0,0,0,1" Padding="12,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Current state (uncommitted)" Foreground="#6EE7B7" FontSize="10" FontFamily="JetBrains Mono, Cascadia Code, Consolas" VerticalAlignment="Center"/>
        <TextBlock Text="Working Tree (Modified local copy)" Foreground="#A7F3D0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
      </DockPanel>
    </Border>

    <avalon:TextEditor x:Name="LeftEditor" Grid.Row="2" Grid.Column="0" IsReadOnly="True" ShowLineNumbers="True" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="12.5"
                       Background="{DynamicResource ThemeWindowBrush}" Foreground="{DynamicResource ThemePrimaryBrush}" LineNumbersForeground="{DynamicResource ThemeDimBrush}" WordWrap="False"
                       VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto"/>
    <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource ThemeBorderBrush}"/>
    <avalon:TextEditor x:Name="RightEditor" Grid.Row="2" Grid.Column="2" IsReadOnly="True" ShowLineNumbers="True" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="12.5"
                       Background="{DynamicResource ThemeWindowBrush}" Foreground="{DynamicResource ThemePrimaryBrush}" LineNumbersForeground="{DynamicResource ThemeDimBrush}" WordWrap="False"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
  </Grid>
</UserControl>
