<UserControl x:Class="DepupCode.Views.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemePopupBrush}">
  <UserControl.Resources>
    <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Code, Consolas</FontFamily>
    <Style x:Key="ChangeItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="10,4,10,4">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="12,11,8,6">
      <Button DockPanel.Dock="Right" Content="↻" Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" FontSize="14" ToolTip="Refresh" Click="Refresh_Click"/>
      <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="#4B3A93" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
        <TextBlock Text="GIT" Foreground="#C4B5FD" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
      </Border>
      <TextBlock Text="SOURCE CONTROL" Foreground="#E4E4F4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
    </DockPanel>

    <DockPanel Grid.Row="1" Margin="12,0,12,8">
      <TextBlock x:Name="SyncText" DockPanel.Dock="Right" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
      <TextBlock x:Name="BranchText" Foreground="#E4E4F4" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Text="⑂ Branch: -"/>
    </DockPanel>

    <Grid Grid.Row="2" Margin="10,0,10,8">
      <TextBox x:Name="MessageBox" Height="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               FontFamily="{StaticResource Mono}" FontSize="11" Background="{DynamicResource ThemeInputBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" Padding="9,7" TextChanged="Message_Changed"/>
      <TextBlock x:Name="MessageHint" Text="Message (Ctrl+Enter untuk commit &amp; push)" Foreground="{DynamicResource ThemeDimBrush}" FontFamily="{StaticResource Mono}" FontSize="11"
                 Margin="11,8,11,0" IsHitTestVisible="False" TextWrapping="Wrap"/>
    </Grid>

    <Button x:Name="CommitButton" Grid.Row="3" Tag="RequiresCloud" Content="✓   Commit &amp; Push" Style="{StaticResource PrimaryButton}" Margin="10,0,10,6" Height="34" HorizontalContentAlignment="Center" Click="Commit_Click"/>
    <TextBlock x:Name="StatusText" Grid.Row="4" Margin="12,0,12,6" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" TextWrapping="Wrap" FontFamily="{StaticResource Mono}"/>

    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <DockPanel Margin="12,6,12,6">
          <Border DockPanel.Dock="Right" Background="#6D28D9" CornerRadius="8" MinWidth="20" Padding="6,0">
            <TextBlock x:Name="ChangesCount" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="⌄  CHANGES" Foreground="#E4E4F4" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="ChangesList" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ChangeItem}"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Change_Selected">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Height="22" LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="11" FontFamily="{StaticResource Mono}" Margin="8,0,2,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Tag}" Foreground="{Binding TagBrush}" FontWeight="Bold" FontSize="9" FontFamily="{StaticResource Mono}" Width="26" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}">
                  <Run Text="{Binding FileName, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11.5" FontWeight="SemiBold"/>
                  <Run Text="{Binding DirectoryHint, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{DynamicResource ThemeDimBrush}"/>
                </TextBlock>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Text="Working tree bersih." Foreground="{DynamicResource ThemeDimBrush}" FontSize="11" Margin="14,4,0,4" Visibility="Collapsed"/>

        <DockPanel x:Name="IgnoredHeader" Margin="12,14,12,6">
          <TextBlock x:Name="IgnoredCount" DockPanel.Dock="Right" Text="@gitignore" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
          <TextBlock Text="IGNORED &amp; SYSTEM" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <ItemsControl x:Name="IgnoredList" Margin="0,0,0,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Height="20" Margin="12,0,12,0">
                <TextBlock DockPanel.Dock="Right" Text="⁞" Foreground="{DynamicResource ThemeDimBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RelativePath}" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10" FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="NoRepoPanel" Grid.Row="1" Grid.RowSpan="5" Background="{DynamicResource ThemePopupBrush}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="14,8,14,14">
        <TextBlock x:Name="NoRepoText" Foreground="#C9C5E8" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                   Text="Folder yang sedang terbuka belum memiliki repository Git. Anda dapat menginisialisasi repository untuk mengaktifkan fitur source control berbasis Git."/>
        <Button x:Name="InitButton" Content="Initialize Repository" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,14,0,0" HorizontalContentAlignment="Center" Click="Init_Click"/>
        <TextBlock Foreground="#C9C5E8" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,18,0,0"
                   Text="Anda juga bisa langsung mempublikasikan folder ini ke repository GitHub. Setelah dipublikasikan, fitur source control berbasis Git dan GitHub akan aktif."/>
        <CheckBox x:Name="PrivateCheck" Content="Repository private" IsChecked="True" Foreground="#E4E4F4" FontSize="12" Margin="0,12,0,0"/>
        <Button x:Name="PublishButton" Tag="RequiresCloud" Content="⎇   Publish to GitHub" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,10,0,0" HorizontalContentAlignment="Center" Click="Publish_Click"/>
        <TextBlock x:Name="NoRepoStatus" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" Margin="0,12,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
