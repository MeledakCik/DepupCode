<UserControl x:Class="DepupCode.Views.DeployMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeWindowBrush}" SizeChanged="Monitor_SizeChanged">
  <UserControl.Resources>
    <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Code, Consolas</FontFamily>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}"/><Setter Property="FontSize" Value="12"/></Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,22,22">
      <DockPanel Margin="0,0,0,16">
        <Button x:Name="OpenUrlButton" DockPanel.Dock="Right" Tag="RequiresCloud" Content="↗  Open Live URL" Style="{StaticResource PrimaryButton}" Padding="14,7" IsEnabled="False" Click="OpenUrl_Click"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="#6C6794" Margin="0,0,10,0"/>
          <TextBlock Text="Live Pipeline Monitor:" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="BuildNumber" Text=" #—" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource Mono}"/>
          <Border Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" CornerRadius="5" Padding="9,3" Margin="12,0,0,0">
            <TextBlock x:Name="GitChip" Text="belum ada deploy" Foreground="#C4B5FD" FontSize="11" FontFamily="{StaticResource Mono}"/>
          </Border>
        </StackPanel>
      </DockPanel>

      <UniformGrid x:Name="MetricGrid" Columns="4" Margin="-5,0,-5,0">
        <Border Style="{StaticResource Card}" Margin="5">
          <StackPanel>
            <TextBlock Text="Elapsed Build Time" Style="{StaticResource MetricLabel}"/>
            <TextBlock x:Name="ElapsedText" Text="0m 00s" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,8,0,4"/>
            <TextBlock x:Name="ElapsedSub" Text="Idle" Foreground="#34D399" FontSize="11"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="5">
          <StackPanel>
            <TextBlock Text="Pipeline Progress" Style="{StaticResource MetricLabel}"/>
            <TextBlock x:Name="PercentText" Text="0%" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,8,0,8"/>
            <ProgressBar x:Name="MiniProgress" Height="5" Minimum="0" Maximum="100" Foreground="{DynamicResource ThemeAccentBrush}" Background="{DynamicResource ThemeBorderBrush}" BorderThickness="0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="5">
          <StackPanel>
            <TextBlock Text="Platform Target" Style="{StaticResource MetricLabel}"/>
            <TextBlock x:Name="PlatformText" Text="—" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PlatformSub" Text="Pilih platform di panel kiri" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="5">
          <StackPanel>
            <TextBlock Text="Production URL" Style="{StaticResource MetricLabel}"/>
            <TextBlock x:Name="UrlText" Text="—" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="13" FontFamily="{StaticResource Mono}" Margin="0,12,0,6" TextTrimming="CharacterEllipsis" Cursor="Hand" MouseDown="UrlText_MouseDown"/>
            <TextBlock x:Name="UrlSub" Text="Belum ada URL" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,16">
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" CornerRadius="11" Padding="10,3">
              <TextBlock x:Name="StagePillText" Text="Idle" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource Mono}"/>
            </Border>
            <TextBlock Text="⚙  CONTINUOUS DELIVERY PIPELINE STAGES" Foreground="#E4E4F4" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
          </DockPanel>
          <UniformGrid x:Name="StageGrid" Rows="1" Columns="5" Margin="-4,14,-4,0"/>
          <TextBlock x:Name="StageMessage" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" FontFamily="{StaticResource Mono}" Margin="0,12,0,0" TextWrapping="Wrap" Text="Jalankan Check Compatibility lalu Start Deploy dari panel kiri."/>
        </StackPanel>
      </Border>

      <Grid x:Name="DetailGrid" Margin="-5,5,-5,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ParamsCard" Grid.Column="0" Style="{StaticResource Card}" Margin="5,5,5,5">
          <StackPanel>
            <TextBlock Text="☰  Active Build Parameters" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
            <ItemsControl x:Name="ParamList" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource ThemePrimaryBrush}" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                      <TextBlock Text="{Binding Key}" Foreground="{DynamicResource ThemeMutedBrush}" FontFamily="{StaticResource Mono}" FontSize="12"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border x:Name="ArtifactsCard" Grid.Column="1" Style="{StaticResource Card}" Margin="5,5,5,5">
          <StackPanel>
            <TextBlock Text="⬡  Generated Artifacts &amp; Config Complements" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
            <ItemsControl x:Name="ArtifactList" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#0E0C1A" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                    <StackPanel>
                      <TextBlock Text="{Binding Path}" Foreground="#C4B5FD" FontFamily="{StaticResource Mono}" FontSize="12"/>
                      <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ArtifactEmpty" Text="Belum ada artefak. Jalankan Check Compatibility." Foreground="{DynamicResource ThemeDimBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
