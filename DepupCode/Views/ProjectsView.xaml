<UserControl x:Class="DepupCode.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeWindowBrush}">
  <UserControl.Resources>
    <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Mono, Cascadia Code, Consolas</FontFamily>

    <Style x:Key="FilterPillStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}"/>
      <Setter Property="Background" Value="#17132B"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="Margin" Value="5,2,0,2"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="PillBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PillBd" Property="Background" Value="#231C42"/>
                <Setter TargetName="PillBd" Property="BorderBrush" Value="#4B3A93"/>
                <Setter Property="Foreground" Value="#E4E4F4"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="PillBd" Property="Background" Value="{StaticResource PrimaryGradient}"/>
                <Setter TargetName="PillBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StarterCardStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CardBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CardBd" Property="Background" Value="#181430"/>
                <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CardBd" Property="Opacity" Value="0.88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource ThemeWindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Sub-header Breadcrumb & Tunnel / Web Dashboard bar matching Stitch AI -->
    <Border Grid.Row="0" Background="#0F0C1D" BorderBrush="#231C42" BorderThickness="0,0,0,1" Padding="20,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Link Gaib: " Foreground="{DynamicResource ThemeDimBrush}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="TunnelHeaderStatusText" Text="Tunnel Aktif" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"
                     VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="TunnelStatus_Click"/>
          <Ellipse x:Name="TunnelHeaderDot" Width="6" Height="6" Fill="#34D399" Margin="6,0,12,0" VerticalAlignment="Center"/>
          <TextBlock Text="·" Foreground="#4B3A93" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <TextBlock Text="↗  Buka Dashboard Web" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="11" FontWeight="SemiBold"
                     VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenWebDashboard_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Depup Code" Foreground="{DynamicResource ThemeDimBrush}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="  ›  " Foreground="#4B3A93" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="Workspace Manager" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="  ›  " Foreground="#4B3A93" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="BreadcrumbFilterTitle" Text="Semua Project (4)" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource ThemeWindowBrush}">
      <StackPanel Margin="22,18,22,24" MaxWidth="1480">

        <!-- Title Row & Action Buttons -->
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Projects &amp; Workspaces" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryBrush}"/>
              <Border Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="#4B3A93" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="12,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="Depup Cloud v2.4" Foreground="#C4B5FD" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="Project lokal, repository cloud, dan pipeline deployment yang sudah tersambung di perangkat ini."
                       Foreground="{DynamicResource ThemeMutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SyncPlatformButton" Tag="RequiresCloud" Background="{DynamicResource ThemePopupBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" Padding="13,7" Margin="0,0,10,0" Click="Sync_Click">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                  <Canvas Width="24" Height="24">
                    <Path Data="M21,12 A9,9 0 1,1 18.36,5.64 L21,8 M21,3 L21,8 L16,8" Stroke="#C4B5FD" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Sinkronkan Platform" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Content="＋  Tambah Repository" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="ConnectRepository_Click"/>
          </StackPanel>
        </Grid>

        <!-- Search & Filter Pills Bar -->
        <Border Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="200" MaxWidth="420"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ThemeWindowBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,2" HorizontalAlignment="Stretch">
              <Grid>
                <DockPanel>
                  <Viewbox DockPanel.Dock="Left" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Data="M21,21 L15.8,15.8 M18,10.5 A7.5,7.5 0 1,1 3,10.5 A7.5,7.5 0 1,1 18,10.5 Z" Stroke="#9490B8" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                    </Canvas>
                  </Viewbox>
                  <TextBox x:Name="ProjectSearchBox" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemePrimaryBrush}" CaretBrush="{DynamicResource ThemePrimaryBrush}"
                           FontSize="12" Padding="2,4" VerticalContentAlignment="Center" TextChanged="ProjectFilter_Changed"/>
                </DockPanel>
                <TextBlock x:Name="SearchPlaceholder" Text="Filter nama project, branch, atau framework..."
                           Foreground="{DynamicResource ThemeDimBrush}" FontSize="11.5" Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </Border>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
              <RadioButton x:Name="PillAll" Content="Semua (4)" Tag="ALL" IsChecked="True" Style="{StaticResource FilterPillStyle}" Checked="FilterPill_Checked"/>
              <RadioButton x:Name="PillActive" Content="Aktif (3)" Tag="ACTIVE" Style="{StaticResource FilterPillStyle}" Checked="FilterPill_Checked"/>
              <RadioButton x:Name="PillRailway" Content="Railway" Tag="RAILWAY" Style="{StaticResource FilterPillStyle}" Checked="FilterPill_Checked"/>
              <RadioButton x:Name="PillDepupEdge" Content="Depup Edge" Tag="DEPUP" Style="{StaticResource FilterPillStyle}" Checked="FilterPill_Checked"/>
              <RadioButton x:Name="PillLocal" Content="Hanya Lokal (1)" Tag="LOCAL" Style="{StaticResource FilterPillStyle}" Checked="FilterPill_Checked"/>
            </WrapPanel>
          </Grid>
        </Border>

        <!-- Main Projects Table Card -->
        <Border Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
          <StackPanel>
            <!-- Table Column Headers -->
            <Border Background="#16122B" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.5*"/>
                  <ColumnDefinition Width="1.25*"/>
                  <ColumnDefinition Width="1.65*"/>
                  <ColumnDefinition Width="1.05*"/>
                  <ColumnDefinition Width="196"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NAMA PROJECT &amp; PATH LOKAL" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                <TextBlock Grid.Column="1" Text="PLATFORM CLOUD" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                <TextBlock Grid.Column="2" Text="STATUS DEPLOYMENT" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                <TextBlock Grid.Column="3" Text="DIPERBARUI" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                <TextBlock Grid.Column="4" Text="AKSI CEPAT" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
              </Grid>
            </Border>

            <!-- Project Rows -->
            <ItemsControl x:Name="ProjectsListControl">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="RowBorder" Background="{DynamicResource ThemePanelBrush}" BorderBrush="#221B3F" BorderThickness="0,0,0,1" Padding="18,13">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="1.65*"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="196"/>
                      </Grid.ColumnDefinitions>

                      <!-- Column 0: Project Icon, Name, SEDANG DIBUKA badge, Framework badge, Local Path & Branch -->
                      <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{Binding IconBackground}"
                                BorderBrush="{Binding IconBorder}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding IconGlyph}" Foreground="{Binding IconForeground}" FontSize="14"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="13.5" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="ProjectTitle_Click"/>
                            <Border Visibility="{Binding OpenBadgeVisibility}" Background="#0F2A22" BorderBrush="#1E5A45"
                                    BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0" VerticalAlignment="Center">
                              <TextBlock Text="SEDANG DIBUKA" Foreground="#34D399" FontSize="8.5" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                            </Border>
                            <Border Background="#1A1533" BorderBrush="#2E2654" BorderThickness="1" CornerRadius="4" Padding="7,1.5" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Framework}" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="9.5" FontFamily="{StaticResource Mono}"/>
                            </Border>
                          </WrapPanel>
                          <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding DisplayPath}" Foreground="{DynamicResource ThemeDimBrush}" FontSize="11" FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            <TextBlock Text="  •  " Foreground="#4B3A93" FontSize="11" FontFamily="{StaticResource Mono}"/>
                            <TextBlock Text="{Binding BranchAndCommit}" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="11" FontFamily="{StaticResource Mono}"/>
                          </WrapPanel>
                        </StackPanel>
                      </DockPanel>

                      <!-- Column 1: Platform Cloud -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse Visibility="{Binding PlatformDotVisibility}" Width="7" Height="7" Fill="{Binding PlatformDotBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Platform}" Foreground="{Binding PlatformTitleBrush}" FontStyle="{Binding PlatformFontStyle}"
                                     FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PlatformSub}" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                      </StackPanel>

                      <!-- Column 2: Status Deployment -->
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Visibility="{Binding NormalStatusVisibility}">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusTextBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                          </StackPanel>
                          <TextBlock Visibility="{Binding SiteUrlVisibility}" Text="{Binding DisplaySiteUrl}" Foreground="{DynamicResource ThemeAccentSoftBrush}"
                                     FontSize="11" FontFamily="{StaticResource Mono}" Margin="0,4,0,0" Cursor="Hand"
                                     TextTrimming="CharacterEllipsis" MouseLeftButtonUp="SiteUrl_Click" ToolTip="Klik untuk membuka di browser"/>
                          <ProgressBar Visibility="{Binding ProgressVisibility}" Value="{Binding BuildProgress, Mode=OneWay}"
                                       Minimum="0" Maximum="100" Height="5" Width="150" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource ThemeAccentBrush}" Background="{DynamicResource ThemeHoverBrush}" Margin="0,7,0,0"/>
                        </StackPanel>

                        <Border Visibility="{Binding LocalBadgeVisibility}" Background="#241A12" BorderBrush="#6B4419"
                                BorderThickness="1" CornerRadius="5" Padding="9,4" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="○ " Foreground="#F59E0B" FontSize="10.5" FontWeight="Bold"/>
                            <TextBlock Text="Hanya Lokal" Foreground="#FBBF24" FontSize="11" FontWeight="SemiBold"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <!-- Column 3: Updated -->
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding RelativeUpdatedText}" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="11.5" FontWeight="Medium"/>
                        <TextBlock Text="{Binding UpdatedSubtitle}" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10.5" FontFamily="{StaticResource Mono}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>

                      <!-- Column 4: Quick Actions -->
                      <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="PrimaryRowButton" Tag="{Binding PrimaryActionCloudTag}" Content="{Binding PrimaryActionLabel}" Padding="11,5" FontSize="11"
                                Margin="0,0,6,0" Click="PrimaryAction_Click"/>
                        <Button Tag="RequiresCloud" Width="28" Height="28" Padding="0" Background="#17132B" BorderBrush="#2E2654"
                                Margin="0,0,5,0" ToolTip="Sinkronkan / Redeploy Pipeline" Click="Redeploy_Click">
                          <Viewbox Width="12" Height="12">
                            <Canvas Width="24" Height="24">
                              <Path Data="M21,12 A9,9 0 1,1 18.36,5.64 L21,8 M21,3 L21,8 L16,8" Stroke="#C4B5FD" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                          </Viewbox>
                        </Button>
                        <Button Width="26" Height="28" Padding="0" Background="Transparent" BorderBrush="Transparent"
                                ToolTip="Opsi Project" Click="MoreActions_Click">
                          <Viewbox Width="12" Height="12">
                            <Canvas Width="24" Height="24">
                              <Ellipse Canvas.Left="10" Canvas.Top="3" Width="4" Height="4" Fill="#9490B8"/>
                              <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="#9490B8"/>
                              <Ellipse Canvas.Left="10" Canvas.Top="17" Width="4" Height="4" Fill="#9490B8"/>
                            </Canvas>
                          </Viewbox>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                      <Setter TargetName="RowBorder" Property="Background" Value="#16122C"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding UsePrimaryAccentButton}" Value="True">
                      <Setter TargetName="PrimaryRowButton" Property="Style" Value="{StaticResource PrimaryButton}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding UseDeployOutlineButton}" Value="True">
                      <Setter TargetName="PrimaryRowButton" Property="Background" Value="#21183C"/>
                      <Setter TargetName="PrimaryRowButton" Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                      <Setter TargetName="PrimaryRowButton" Property="Foreground" Value="#DDD6FE"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Table Footer Bar -->
            <Border Background="#100D20" Padding="18,10">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Path Default: " Foreground="{DynamicResource ThemeDimBrush}" FontSize="11"/>
                  <TextBlock x:Name="DefaultPathText" Text="Folder project default" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="11" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                  <TextBlock Text="Ubah Lokasi Simpan" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="11" FontWeight="SemiBold"
                             Cursor="Hand" MouseLeftButtonUp="ChangeDefaultPath_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Menampilkan 4 dari 4 project tersimpan di workstation ini."
                           Foreground="{DynamicResource ThemeDimBrush}" FontSize="11" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Bottom Section: Mulai Project Baru atau Hubungkan Pipeline -->
        <StackPanel Margin="0,22,0,0">
          <TextBlock Text="Mulai Project Baru atau Hubungkan Pipeline" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="15" FontWeight="Bold"/>
          <TextBlock Text="Pilih template siap pakai atau impor repository yang sudah ada." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11.5" Margin="0,4,0,12"/>

          <UniformGrid Columns="3" Margin="-6,0,-6,0">
            <!-- Card 1: Clone dari Git Remote -->
            <Button Tag="RequiresCloud" Style="{StaticResource StarterCardStyle}" Margin="6,0" Click="CloneGitCard_Click">
              <StackPanel>
                <DockPanel>
                  <Border Width="34" Height="34" CornerRadius="8" Background="#1D1636" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <Viewbox Width="16" Height="16">
                      <Canvas Width="24" Height="24">
                        <Path Data="M7,6 A2.5,2.5 0 1,1 7,1.1 A2.5,2.5 0 1,1 7,6 Z M7,22 A2.5,2.5 0 1,1 7,17.1 A2.5,2.5 0 1,1 7,22 Z M17,14 A2.5,2.5 0 1,1 17,9.1 A2.5,2.5 0 1,1 17,14 Z M7,6 L7,17 M7,10 C7,12 10,12 14.5,12"
                              Stroke="#A78BFA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                      </Canvas>
                    </Viewbox>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Clone dari Git Remote" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="GitHub, GitLab, Bitbucket" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10.5" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="Clone repository cloud langsung ke local drive dan siapkan Depup tunnel otomatis."
                           Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" LineHeight="16"/>
              </StackPanel>
            </Button>

            <!-- Card 2: Inisialisasi Template Baru -->
            <Button Style="{StaticResource StarterCardStyle}" Margin="6,0" Click="InitTemplateCard_Click">
              <StackPanel>
                <DockPanel>
                  <Border Width="34" Height="34" CornerRadius="8" Background="#0F2A22" BorderBrush="#1E5A45" BorderThickness="1" Margin="0,0,12,0">
                    <Viewbox Width="16" Height="16">
                      <Canvas Width="24" Height="24">
                        <Path Data="M4,21 L4,14 M4,10 L4,3 M12,21 L12,12 M12,8 L12,3 M20,21 L20,16 M20,12 L20,3 M1,14 L7,14 M9,8 L15,8 M17,16 L23,16"
                              Stroke="#34D399" StrokeThickness="2" StrokeStartLineCap="Round"/>
                      </Canvas>
                    </Viewbox>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Inisialisasi Template Baru" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="Next.js, Vite, Capacitor, Fastify" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10.5" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="Scaffold boilerplate full-stack yang sudah terkonfigurasi dengan Depup Cloud pipeline."
                           Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" LineHeight="16"/>
              </StackPanel>
            </Button>

            <!-- Card 3: Buka Folder Lokal -->
            <Button Style="{StaticResource StarterCardStyle}" Margin="6,0" Click="OpenLocalFolderCard_Click">
              <StackPanel>
                <DockPanel>
                  <Border Width="34" Height="34" CornerRadius="8" Background="#1D1636" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <Viewbox Width="16" Height="16">
                      <Canvas Width="24" Height="24">
                        <Path Data="M3,7 L3,17 C3,18.1 3.9,19 5,19 L19,19 C20.1,19 21,18.1 21,17 L21,9 C21,7.9 20.1,7 19,7 L13,7 L11,5 L5,5 C3.9,5 3,5.9 3,7 Z"
                              Stroke="#C4B5FD" StrokeThickness="2" StrokeLineJoin="Round"/>
                      </Canvas>
                    </Viewbox>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Buka Folder Lokal" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="Pilih direktori di Hard Drive" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10.5" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="Pilih folder existing di komputer Anda dan tambahkan file konfigurasi 'depup.config'."
                           Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" LineHeight="16"/>
              </StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
