<UserControl x:Class="DepupCode.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemePopupBrush}">
  <UserControl.Resources>
    <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Code, Consolas</FontFamily>
    <Style x:Key="PlatformCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C9C5E8"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="#0E0C1A" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0">
              <DockPanel VerticalAlignment="Center">
                <TextBlock x:Name="Check" DockPanel.Dock="Right" Text="✓" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontWeight="Bold" Visibility="Collapsed" Margin="6,0,0,0"/>
                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold" RecognizesAccessKey="False"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorderLightBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,12,0,5"/>
    </Style>
    <Style x:Key="HistoryItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorderLightBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,12">
      <DockPanel Margin="12,11,12,4">
        <TextBlock Text="🚀" DockPanel.Dock="Left" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBlock Text="RUN &amp; DEPLOY: DEPUP CLOUD" Foreground="#E4E4F4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>

      <DockPanel Margin="12,10,12,0">
        <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="#6D28D9" BorderThickness="1" CornerRadius="4" Padding="7,1">
          <TextBlock Text="PRODUCTION" Foreground="#C4B5FD" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
        </Border>
        <TextBlock Text="⌄  DEPLOY CONFIGURATION" Foreground="#E4E4F4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>

      <StackPanel Margin="12,0,12,0">
        <TextBlock Text="GitHub URL atau Folder Workspace" Style="{StaticResource SectionLabel}"/>
          <TextBox x:Name="RepositoryUrlBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" FontSize="11.5" Background="{DynamicResource ThemeInputBrush}" ToolTip="Tempel URL repository GitHub, atau kosongkan untuk memakai folder lokal aktif"/>
        <TextBlock Text="Project name (optional)" Style="{StaticResource SectionLabel}"/>
        <TextBox x:Name="ProjectNameBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" FontSize="12" Background="{DynamicResource ThemeInputBrush}"/>

        <TextBlock Text="Deployment Target Platform" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
        <UniformGrid Columns="2">
          <RadioButton x:Name="DepupCloudRadio" Content="Depup Edge" ToolTip="Depup Cloud (depup.cloud)" Tag="Depup Edge CDN" GroupName="platform" IsChecked="True" Style="{StaticResource PlatformCard}"/>
          <RadioButton x:Name="RailwayRadio" Content="Railway" Tag="Railway" GroupName="platform" Style="{StaticResource PlatformCard}" Margin="0,0,0,6"/>
          <RadioButton x:Name="VercelRadio" Content="Vercel" Tag="Vercel" GroupName="platform" Style="{StaticResource PlatformCard}"/>
          <RadioButton x:Name="CloudflareRadio" Content="Cloudflare" ToolTip="Cloudflare Pages" Tag="Cloudflare Pages" GroupName="platform" Style="{StaticResource PlatformCard}" Margin="0,0,0,6"/>
        </UniformGrid>
        <CheckBox x:Name="DepupCloudRouteCheckBox" Content="Deploy lewat akun Depup Cloud dan simpan ke riwayat cloud" Foreground="#C4B5FD" FontSize="10" Margin="0,3,0,7"
                  ToolTip="Berlaku untuk Railway / Vercel / Cloudflare. Memakai sesi Depup Cloud (token provider boleh diambil dari akun), memantau status build, dan menyimpan riwayat ke akun. Matikan untuk memanggil provider langsung dengan token lokal."/>

        <Border x:Name="AnalysisCard" Visibility="Collapsed" Background="#0F2A22" BorderBrush="#1E5A45" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2,0,0">
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="CompatBadge" DockPanel.Dock="Right" Text="OK" Foreground="#34D399" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
              <TextBlock Text="🛡  Compatibility: Passed" Foreground="#34D399" FontWeight="SemiBold" FontSize="12"/>
            </DockPanel>
            <TextBlock x:Name="AnalysisSummary" Foreground="#A7F3D0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="AnalysisFiles" Foreground="#6EE7B7" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" FontFamily="{StaticResource Mono}"/>
            <ItemsControl x:Name="FixesList" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2,0,0"><TextBlock Text="＋" Foreground="#34D399" FontWeight="Bold" Margin="0,0,6,0"/><TextBlock Text="{Binding Path}" Foreground="#C4B5FD" FontSize="10" FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/></DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="ApplyLocalFixesButton" Visibility="Collapsed" Content="Terapkan pelengkap ke folder lokal" Margin="0,6,0,0" Padding="8,4" FontSize="10" Click="ApplyLocalFixes_Click"/>
            <TextBlock x:Name="NoFixesText" Text="Tidak ada file konfigurasi tambahan." Foreground="#6EE7B7" FontSize="10" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Button x:Name="CheckButton" Content="⌕   Check Compatibility" Height="34" Margin="0,10,0,0" HorizontalContentAlignment="Center" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" Click="Check_Click"/>
        <Button x:Name="DeployButton" Tag="RequiresCloud" Content="⚡  Start Deploy to Cloud" Style="{StaticResource PrimaryButton}" Height="38" Margin="0,8,0,0" HorizontalContentAlignment="Center" IsEnabled="False" Click="Deploy_Click"/>
        <ProgressBar x:Name="DeployProgress" Height="5" Minimum="0" Maximum="100" Foreground="{DynamicResource ThemeAccentBrush}" Background="{DynamicResource ThemeBorderBrush}" BorderThickness="0" Margin="0,10,0,0"/>
        <TextBlock x:Name="ProgressMessage" Text="Menunggu repository atau folder workspace untuk diperiksa." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="{StaticResource Mono}"/>
        <TextBlock x:Name="ResultLink" Foreground="#34D399" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Cursor="Hand" MouseDown="OpenResult"/>
      </StackPanel>

      <Border Background="{DynamicResource ThemeBorderBrush}" Height="1" Margin="0,16,0,0"/>
      <DockPanel Margin="12,12,12,8">
        <TextBlock x:Name="HistoryTotal" DockPanel.Dock="Right" Text="TOTAL: 0" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
        <TextBlock Text="⌄  PIPELINE &amp; HISTORY" Foreground="#E4E4F4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>
      <ListBox x:Name="HistoryList" Margin="12,0,12,0" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource HistoryItem}"
               ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="History_Selected">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="4" Padding="6,1"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="9" FontFamily="{StaticResource Mono}"/></Border>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <DockPanel Margin="0,3,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10" FontFamily="{StaticResource Mono}"/>
                <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10"/>
              </DockPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="HistoryEmpty" Text="Belum ada deployment tersimpan." Foreground="{DynamicResource ThemeDimBrush}" FontSize="11" Margin="14,0,0,0"/>

      <Border Background="{DynamicResource ThemeBorderBrush}" Height="1" Margin="0,12,0,0"/>
      <Button Content="›  ENV VARIABLES &amp; SECRETS" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="6,6,6,0" Padding="6,8" FontWeight="Bold" FontSize="11" Foreground="#E4E4F4" Click="Env_Click"/>
      <TextBlock Text="Kelola variabel lingkungan terenkripsi (DPAPI) untuk project yang dideploy." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="14,0,14,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
