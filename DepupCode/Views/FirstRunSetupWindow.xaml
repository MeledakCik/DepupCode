<Window x:Class="DepupCode.Views.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selamat datang - Depup Code"
        Width="880" Height="680" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#0C0A17" Foreground="#F8FAFC"
        Icon="pack://application:,,,/Assets/depup.png"
        ShowInTaskbar="True" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="28,24,28,22" Background="#16132B" BorderBrush="#2A224F" BorderThickness="0,0,0,1">
      <DockPanel>
        <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/icon-128.png"
               Width="46" Height="46" Margin="0,0,16,0" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Selamat datang di Depup Code" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="Pilih workspace dan preferensi awal. Semua pengaturan dapat diubah nanti melalui Settings."
                     Foreground="#C4B5FD" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,22">
      <StackPanel>
        <Border Background="#120F24" BorderBrush="#382F69" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="1  Pilih folder workspace" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Depup Code membuka folder yang sudah ada. File project Anda tidak dipindahkan atau diubah."
                       Foreground="#9490B8" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <Grid Margin="0,13,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PathBox" Height="36" VerticalContentAlignment="Center"
                       ToolTip="Ketik atau tempel path folder workspace" TextChanged="PathBox_TextChanged"/>
              <Button Grid.Column="1" Content="Telusuri..." Padding="16,8" Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>

            <TextBlock x:Name="PathStatusText" FontSize="11.5" Margin="2,7,0,0" TextWrapping="Wrap"
                       Foreground="#9490B8" Text="Belum ada folder dipilih."/>

            <StackPanel x:Name="RecentPanel" Margin="0,16,0,0" Visibility="Collapsed">
              <TextBlock Text="Workspace terbaru" Foreground="#C4B5FD" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <ListBox x:Name="RecentList" MaxHeight="148" SelectionChanged="RecentList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="10,6">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                      <TextBlock Text="{Binding FullPath}" Foreground="#9490B8" FontSize="10.5"
                                 TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="#120F24" BorderBrush="#382F69" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="2  Preferensi awal" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Anda dapat mengganti tema dan ukuran editor kapan saja dari Settings."
                       Foreground="#9490B8" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Tema aplikasi" Foreground="#C4B5FD" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="ThemeBox" Height="36" VerticalContentAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Ukuran font editor" Foreground="#C4B5FD" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="FontSizeBox" Height="36" VerticalContentAlignment="Center"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="#101A16" BorderBrush="#1F4D3A" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Privasi dan data" FontSize="13" FontWeight="SemiBold" Foreground="#A7F3D0"/>
            <TextBlock Foreground="#C7D2DC" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Depup Code tidak mengirim kode atau data project secara otomatis. Data hanya dikirim saat Anda menjalankan fitur online seperti AI, Git, atau deploy, dan persetujuan privasi sudah Anda tinjau sebelumnya."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#0F0B1E" BorderBrush="#2A224F" BorderThickness="0,1,0,0" Padding="28,16">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="FooterStatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                   Foreground="#9490B8" FontSize="11.5" TextWrapping="Wrap" MaxWidth="420"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Lewati untuk sekarang" Click="Skip_Click" Padding="16,8" Margin="0,0,10,0"/>
          <Button x:Name="StartButton" Content="Mulai" Style="{StaticResource PrimaryButton}"
                  Click="Start_Click" IsDefault="True" Padding="24,8" MinWidth="120"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
