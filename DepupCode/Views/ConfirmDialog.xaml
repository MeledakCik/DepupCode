<Window x:Class="DepupCode.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Depup Code">
  <Border Background="#160E2A" BorderBrush="#3A2760" BorderThickness="1" CornerRadius="10" Padding="20" Width="430" MouseLeftButtonDown="Drag">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
    <StackPanel>
      <DockPanel Margin="0,0,0,8">
        <Border x:Name="IconBadge" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="#2A1B4D" Margin="0,0,12,0">
          <TextBlock x:Name="IconText" Text="!" Foreground="#FBBF24" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="TitleText" Text="Konfirmasi" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="MessageText" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="46,0,0,18" LineHeight="19"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Batal" MinWidth="76" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
        <Button x:Name="ConfirmButton" Content="Hapus" MinWidth="86" Click="Confirm_Click" Background="#7F1D1D" BorderBrush="#B91C1C"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
