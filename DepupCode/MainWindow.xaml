                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource IconToolbarButton}" ToolTip="Buka Folder Lokal" Click="OpenFolder_Click">
                        <Viewbox Width="13" Height="13">
                          <Canvas Width="24" Height="24">
                            <Path Data="M22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,5 C2,3.9 2.9,3 4,3 L9,3 L11,6 L20,6 C21.1,6 22,6.9 22,8 Z M12,11 L12,17 M9,14 L15,14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Style="{StaticResource IconToolbarButton}" ToolTip="Sinkronkan Katalog" Click="RefreshProjectsSidebar_Click">
                        <Viewbox Width="13" Height="13">
                          <Canvas Width="24" Height="24">
                            <Path Data="M21,12 A9,9 0 1,1 18.36,5.64 L21,8 M21,3 L21,8 L16,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Style="{StaticResource IconToolbarButton}" ToolTip="Switch ke File Explorer" Click="SwitchToExplorer_Click">
                        <Viewbox Width="12" Height="12">
                          <Canvas Width="24" Height="24">
                            <Path Data="M6,9 L12,15 L18,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                    </StackPanel>
                    <TextBlock Text="PROJECTS &amp; WORKSPACES" Foreground="#C4B5FD" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>

                <!-- Section: WORKSPACE AKTIF -->
                <DockPanel Margin="14,10,14,7">
                  <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center"/>
                  <TextBlock Text="WORKSPACE AKTIF" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                </DockPanel>

                <Border Margin="12,0,12,14" Background="#1A1333" BorderBrush="#4C388E" BorderThickness="1" CornerRadius="8" Padding="12,10"
                        Cursor="Hand" MouseLeftButtonUp="ActiveWorkspaceCard_Click" ToolTip="Klik untuk membuka di Code Editor">
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeHoverBrush}" BorderBrush="#4B3A93" BorderThickness="1" CornerRadius="4" Padding="6,1">
                        <TextBlock x:Name="ActiveWorkspaceFrameworkBadge" Text="Next.js" Foreground="#C4B5FD" FontSize="9" FontWeight="SemiBold" FontFamily="{StaticResource Mono}"/>
                      </Border>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" Foreground="#F97316" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActiveWorkspaceTitleText" Text="No Workspace" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="ActiveWorkspacePathText" Text="Open a folder to get started" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" FontFamily="{StaticResource Mono}" Margin="0,5,0,8" TextTrimming="CharacterEllipsis"/>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="v2.5.0" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9.5" FontFamily="{StaticResource Mono}"/>
                      <TextBlock Text="Workspace Ready" Foreground="#34D399" FontSize="10" FontWeight="SemiBold"/>
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Section: WORKSPACE LOKAL TERKINI -->
                <DockPanel Margin="14,2,12,6">
                  <Button DockPanel.Dock="Right" Content="＋" Width="20" Height="20" Padding="0" FontSize="12" Style="{StaticResource IconToolbarButton}" ToolTip="Tambah Folder Workspace Lokal" Click="OpenFolder_Click"/>
                  <TextBlock Text="WORKSPACE LOKAL TERKINI" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel x:Name="RecentWorkspacesList" Margin="6,0,8,12"/>

                <!-- Section: CLOUD REPOSITORIES (GITHUB) -->
                <DockPanel Margin="14,4,14,6">
                  <TextBlock Text="CLOUD REPOSITORIES (GITHUB) @DEPUP-DEV" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <StackPanel x:Name="CloudReposSidebarList" Margin="6,0,8,12"/>

                <!-- Section: PLATFORM TERHUBUNG -->
                <DockPanel Margin="14,4,14,8">
                  <TextBlock x:Name="ConnectedPlatformsCountText" DockPanel.Dock="Right" Text="2 AKTIF" Foreground="#34D399" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                  <TextBlock Text="PLATFORM TERHUBUNG" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                </DockPanel>

                <StackPanel Margin="14,0,14,6">
                  <DockPanel Margin="0,4">
                    <TextBlock x:Name="RailwaySidebarState" DockPanel.Dock="Right" Text="Live" Foreground="#34D399" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="7" Height="7" Fill="#A855F7" Margin="0,0,8,0"/>
                      <TextBlock Text="Railway (Singapore Edge)" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="11.5"/>
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <TextBlock x:Name="DepupSidebarState" DockPanel.Dock="Right" Text="Live" Foreground="#34D399" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,8,0"/>
                      <TextBlock Text="Depup Edge CDN" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="11.5"/>
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <TextBlock x:Name="VercelSidebarState" DockPanel.Dock="Right" Text="Idle" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10" FontFamily="{StaticResource Mono}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="7" Height="7" Fill="#6C6794" Margin="0,0,8,0"/>
                      <TextBlock Text="Vercel Integration" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11.5"/>
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- Settings navigation replaces the projects list while Settings is active. -->
            <Grid x:Name="SettingsSidebarContent" Grid.Row="0" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" BorderBrush="#231B42" BorderThickness="0,0,0,1" Padding="12,0,8,0">
                <DockPanel>
                  <TextBlock Text="SETTINGS &amp; PREFERENCES" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock DockPanel.Dock="Right" Text="⚙" Foreground="{DynamicResource ThemeDimBrush}" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Grid.Row="1" Margin="10,4,10,5" Background="{DynamicResource ThemeInputBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                  <TextBox x:Name="SettingsSidebarSearchBox" TextChanged="SettingsSidebarSearch_TextChanged"
                           Background="Transparent" Foreground="{DynamicResource ThemeSoftBrush}" BorderThickness="0" Padding="25,0,8,0"
                           FontSize="10.5" VerticalContentAlignment="Center" ToolTip="Search settings"/>
                  <TextBlock Text="⌕" Foreground="{DynamicResource ThemeDimBrush}" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <TextBlock Text="Cari pengaturan…" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10.5" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=SettingsSidebarSearchBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="6,4,6,12">
                  <TextBlock x:Name="SettingsPreferencesGroupHeader" Text="PREFERENCES &amp; EXTENSIONS" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontWeight="Bold"
                             FontFamily="{StaticResource Mono}" Margin="9,9,6,5"/>
                  <Button x:Name="SettingsOverviewButton" Tag="general" Click="SettingsSidebar_Click" Style="{StaticResource SidebarItemButton}"
                          Background="#1D1638" BorderBrush="{DynamicResource ThemeAccentBrush}" Margin="0,1" ToolTip="Editor, appearance, dan behavior aplikasi">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="⚙" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="11" Margin="0,0,8,0"/>
                      <TextBlock Text="General &amp; Appearance"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="SettingsExtensionsButton" Tag="extensions" Click="SettingsSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="▧" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="11" Margin="0,0,8,0"/>
                      <TextBlock Text="Built-in Features"/>
                    </StackPanel>
                  </Button>

                  <TextBlock x:Name="SettingsCloudGroupHeader" Text="CLOUD INTEGRATIONS" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontWeight="Bold"
                             FontFamily="{StaticResource Mono}" Margin="9,17,6,5"/>
                  <Button x:Name="SettingsVercelButton" Tag="vercel" Click="SettingsSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <DockPanel>
                      <TextBlock Text="Vercel API"/>
                    </DockPanel>
                  </Button>
                  <Button x:Name="SettingsCloudflareButton" Tag="cloudflare" Click="SettingsSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <TextBlock Text="Cloudflare Pages"/>
                  </Button>
                  <Button x:Name="SettingsRailwayButton" Tag="railway" Click="SettingsSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <TextBlock Text="Railway Platform"/>
                  </Button>

                  <TextBlock x:Name="SettingsDeveloperGroupHeader" Text="DEVELOPER TOOLS" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontWeight="Bold"
                             FontFamily="{StaticResource Mono}" Margin="9,17,6,5"/>
                  <Button x:Name="SettingsLinkGaibButton" Tag="linkgaib" Click="SettingsSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <TextBlock Text="Link Gaib &amp; Edge Tunnels" TextTrimming="CharacterEllipsis"/>
                  </Button>
                  <Button x:Name="SettingsGitHubButton" Tag="github" Click="SettingsSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <TextBlock Text="Git &amp; Source Control"/>
                  </Button>

                  <TextBlock x:Name="SettingsSecurityGroupHeader" Text="SECURITY" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontWeight="Bold"
                             FontFamily="{StaticResource Mono}" Margin="9,17,6,5"/>
                  <Button x:Name="SettingsSecurityButton" Tag="security" Click="SettingsSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="●" Foreground="#34D399" FontSize="8" VerticalAlignment="Center" Margin="6,0,2,0"/>
                      <TextBlock Text="Security &amp; DPAPI Keystore" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Button>
                  <TextBlock x:Name="SettingsSidebarNoResults" Text="Tidak ada pengaturan yang cocok." Foreground="{DynamicResource ThemeDimBrush}" FontSize="10"
                             TextWrapping="Wrap" Margin="9,12,8,0" Visibility="Collapsed"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Grid x:Name="EnvironmentSidebarContent" Grid.Row="0" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" BorderBrush="#231B42" BorderThickness="0,0,0,1" Padding="12,0,8,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="＋" Style="{StaticResource IconToolbarButton}" Click="EnvironmentSidebarAdd_Click"
                          ToolTip="Tambah environment variable" Width="24" Height="24"/>
                  <TextBlock Text="ENVIRONMENT &amp; SECRETS" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Grid.Row="1" Margin="10,4,10,5" Background="{DynamicResource ThemeInputBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                  <TextBox x:Name="EnvironmentSidebarSearchBox" TextChanged="EnvironmentSidebarSearch_TextChanged"
