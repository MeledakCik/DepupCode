              </Border>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="6,4,6,12">
                  <TextBlock Text="TARGET PROJECT" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="9,8,6,5"/>
                  <Border Margin="4,0,4,10" Background="#1A1333" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="9,8">
                    <StackPanel>
                      <TextBlock x:Name="EnvironmentSidebarProjectText" Text="Current project" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="DPAPI encrypted · local" Foreground="{DynamicResource ThemeDimBrush}" FontSize="8.5"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <TextBlock x:Name="EnvironmentVariableGroupHeader" Text="KATEGORI VARIABEL" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontWeight="Bold"
                             FontFamily="{StaticResource Mono}" Margin="9,8,6,5"/>
                  <Button x:Name="EnvironmentAllButton" Tag="all" Click="EnvironmentSidebar_Click" Style="{StaticResource SidebarItemButton}"
                          Background="#1D1638" BorderBrush="{DynamicResource ThemeAccentBrush}" Margin="0,1">
                    <DockPanel>
                      <TextBlock x:Name="EnvironmentAllCountText" DockPanel.Dock="Right" Text="0" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="8.5" FontWeight="Bold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                      <TextBlock Text="All Variables"/>
                    </DockPanel>
                  </Button>
                  <Button x:Name="EnvironmentSecretsButton" Tag="secret" Click="EnvironmentSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <DockPanel>
                      <TextBlock x:Name="EnvironmentSecretsCountText" DockPanel.Dock="Right" Text="0" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="8.5" FontWeight="Bold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                      <TextBlock Text="Production Secrets"/>
                    </DockPanel>
                  </Button>
                  <Button x:Name="EnvironmentPublicButton" Tag="public" Click="EnvironmentSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <DockPanel>
                      <TextBlock x:Name="EnvironmentPublicCountText" DockPanel.Dock="Right" Text="0" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontSize="8.5" FontWeight="Bold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                      <TextBlock Text="Public Config"/>
                    </DockPanel>
                  </Button>

                  <TextBlock x:Name="EnvironmentTargetGroupHeader" Text="TARGET ENVIRONMENT" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9" FontWeight="Bold"
                             FontFamily="{StaticResource Mono}" Margin="9,17,6,5"/>
                  <Button x:Name="EnvironmentProductionButton" Tag="target:Production" Click="EnvironmentSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <TextBlock Text="Production"/>
                  </Button>
                  <Button x:Name="EnvironmentStagingButton" Tag="target:Staging" Click="EnvironmentSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <TextBlock Text="Staging"/>
                  </Button>
                  <Button x:Name="EnvironmentDevelopmentButton" Tag="target:Development" Click="EnvironmentSidebar_Click" Style="{StaticResource SidebarItemButton}" Margin="0,1">
                    <TextBlock Text="Development"/>
                  </Button>
                  <TextBlock x:Name="EnvironmentSidebarNoResults" Text="Tidak ada variabel yang cocok." Foreground="{DynamicResource ThemeDimBrush}" FontSize="10"
                             TextWrapping="Wrap" Margin="9,12,8,0" Visibility="Collapsed"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- 3. Deploy / Git / Search Sidebar Hosts -->
            <ContentControl x:Name="DeployHost" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource ThemePopupBrush}"/>
            <ContentControl x:Name="GitHost" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource ThemePopupBrush}"/>
            <ContentControl x:Name="SearchHost" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource ThemePopupBrush}"/>

            <Border Grid.Row="1" Background="{DynamicResource ThemeSeparatorBrush}"/>

            <!-- Bottom DEPUP CLOUD Embedded Action Box matching Stitch AI -->
            <Border x:Name="SidebarActionsPanel" Grid.Row="2" Background="#110B22" Padding="12,10,12,12">
              <Grid>
                <StackPanel x:Name="DefaultSidebarActionContent">
                  <DockPanel Margin="1,0,1,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="#A855F7" Margin="0,0,5,0" VerticalAlignment="Center"/>
                      <TextBlock Text="v2.4" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="DEPUP CLOUD" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                  </DockPanel>
                  <Button x:Name="SidebarDeployButton" Content="🚀  Deploy to Cloud" Tag="deploy" AutomationProperties.HelpText="RequiresCloud" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center" Click="Nav_Click" Margin="0,0,0,6" Height="34" FontSize="11.5"/>
                  <Button x:Name="SidebarUploadButton" Content="☁  Upload project bundle" Tag="upload" AutomationProperties.HelpText="RequiresCloud" Background="#1C1536" BorderBrush="{DynamicResource ThemeBorderLightBrush}" HorizontalContentAlignment="Center" Click="Nav_Click" Height="30" Padding="7,3" FontSize="11" FontWeight="Normal"/>
                  <DockPanel Margin="1,8,1,0">
                    <TextBlock DockPanel.Dock="Right" Text="Ready" Foreground="#34D399" FontSize="9.5" FontFamily="{StaticResource Mono}" FontWeight="SemiBold"/>
                    <TextBlock Text="Target: depup.cloud/m" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9.5" FontFamily="{StaticResource Mono}"/>
                  </DockPanel>
                </StackPanel>
                <StackPanel x:Name="SettingsSidebarActionContent" Visibility="Collapsed">
                  <DockPanel Margin="1,0,1,7">
                    <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Fill="#A78BFA" VerticalAlignment="Center"/>
                    <TextBlock Text="DEPUP CLOUD SYNC" Foreground="#C4B5FD" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Text="Provider tokens stay encrypted with Windows DPAPI." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="9.5"
                             TextWrapping="Wrap" Margin="1,0,1,8"/>
                  <Button Content="⇧  Sinkronkan Sekarang" Tag="RequiresCloud" Click="SettingsSidebarSync_Click" Style="{StaticResource PrimaryButton}"
                          HorizontalContentAlignment="Center" Height="30" FontSize="10.5"/>
                </StackPanel>
                <StackPanel x:Name="EnvironmentSidebarActionContent" Visibility="Collapsed">
                  <DockPanel Margin="1,0,1,7">
                    <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Fill="#34D399" VerticalAlignment="Center"/>
                    <TextBlock Text="DPUP CLOUD CONTROL" Foreground="#C4B5FD" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Text="Local secrets are protected with Windows DPAPI." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="9.5"
                             TextWrapping="Wrap" Margin="1,0,1,8"/>
                  <Button Content="⇧  Simpan &amp; Sinkronkan" Tag="RequiresCloud" Click="EnvironmentSidebarSync_Click" Style="{StaticResource PrimaryButton}"
                          HorizontalContentAlignment="Center" Height="30" FontSize="10.5"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="{DynamicResource ThemeSeparatorBrush}"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      Cursor="SizeWE" DragCompleted="SidebarSplitter_DragCompleted"
                      ToolTip="Tarik untuk mengatur lebar panel Explorer"/>

        <!-- Right Main Content Area + Bottom Terminal/Output/Problems/Depup Logs Panel -->
        <Grid Grid.Column="3" Background="{DynamicResource ThemeEditorBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="BottomPanelSplitterRow" Height="6"/>
            <RowDefinition x:Name="BottomPanelRow" Height="250" MinHeight="90" MaxHeight="480"/>
          </Grid.RowDefinitions>

          <ContentControl x:Name="WorkspaceHost" Grid.Row="0">
            <Grid x:Name="EditorWorkspace" Background="{DynamicResource ThemeEditorBrush}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="AiPanelSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="AiPanelColumn" Width="0"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition x:Name="EditorBreadcrumbRow" Height="25"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Row 0: Single-Row Editor Tabs + Right Quick Action Toolbar (Stitch AI Cloud IDE design) -->
              <Border Grid.Row="0" Background="{DynamicResource ThemeActivityBrush}" BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0">
                    <ComboBox x:Name="AppThemeComboBox" Width="170" MinWidth="170" Height="25" Margin="0,0,8,0" FontSize="9.5"
                              VerticalContentAlignment="Center" SelectionChanged="AppThemeComboBox_SelectionChanged"
                              ToolTip="Ganti tema warna seluruh DepupCode" ToolTipService.InitialShowDelay="700"
                              AutomationProperties.Name="Tema tampilan seluruh aplikasi">
                    </ComboBox>
                    <Button Content="⌕" Width="27" Padding="0" Margin="0,0,3,0" Click="HeaderFindInFile_Click" FontSize="15" Height="25" Background="{DynamicResource ThemeSurfaceAltBrush}" BorderBrush="#322659" ToolTip="Cari di file aktif (Ctrl+F)"/>
                    <Button Content="✦" Width="27" Padding="0" Margin="0,0,3,0" Click="FormatDocument_Click" FontSize="13" Height="25" Background="{DynamicResource ThemeSurfaceAltBrush}" BorderBrush="#322659" ToolTip="Format dokumen (Shift+Alt+F)"/>
                    <Button Content="▱" Width="27" Padding="0" Margin="0,0,3,0" Click="OpenFolder_Click" FontSize="15" Height="25" Background="{DynamicResource ThemeSurfaceAltBrush}" BorderBrush="#322659" ToolTip="Buka folder workspace (Ctrl+O)"/>
                    <Button Content="▣" Width="27" Padding="0" Click="Save_Click" FontSize="14" Height="25" Style="{StaticResource PrimaryButton}" ToolTip="Simpan file (Ctrl+S)"/>
                    <Button Content="⋯" Width="27" Padding="0" Click="EditorTabActions_Click" FontSize="15" Height="25" Background="{DynamicResource ThemeSurfaceAltBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" ToolTip="Aksi tab editor"/>
                  </StackPanel>
                  <TabControl x:Name="EditorTabs" Grid.Column="0" Background="Transparent" BorderThickness="0" SelectionChanged="EditorTabs_SelectionChanged"/>
                </Grid>
              </Border>

              <!-- Row 1: Slim Breadcrumbs Bar matching Stitch AI -->
              <Border x:Name="EditorBreadcrumbBar" Grid.Row="1" Background="{DynamicResource ThemeEditorBrush}" BorderBrush="#1F163B" BorderThickness="0,0,0,1" Padding="14,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="Ctrl+= / Ctrl+- Zoom UI" Foreground="{DynamicResource ThemeDimBrush}" FontSize="9.5" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="BreadcrumbText" Text="Selamat datang di Depup Code" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Border>

              <!-- Row 2: Code Editor + Find/Replace Floating Bar + Minimap -->
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition x:Name="HtmlPreviewSplitColumn" Width="0"/>
                  <ColumnDefinition x:Name="HtmlPreviewColumn" Width="0"/>
                  <ColumnDefinition x:Name="MinimapSplitColumn" Width="5"/>
                  <ColumnDefinition x:Name="MinimapColumn" Width="108"/>
                </Grid.ColumnDefinitions>

                <avalon:TextEditor x:Name="CodeEditor" Grid.Column="0" ShowLineNumbers="True" FontFamily="{StaticResource Mono}" FontSize="13"
                                   Background="{DynamicResource ThemeEditorBrush}" Foreground="{DynamicResource ThemePrimaryBrush}" LineNumbersForeground="{DynamicResource ThemeLineNumberBrush}" WordWrap="False"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                   ContextMenuOpening="CodeEditor_ContextMenuOpening">
                  <avalon:TextEditor.ContextMenu>
                    <ContextMenu Background="{DynamicResource ThemeMenuBrush}" Foreground="{DynamicResource ThemePrimaryBrush}"
                                 BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" Padding="4" HasDropShadow="True">
                      <ContextMenu.Resources>
                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource SubMenuItemStyle}"/>
                        <Style TargetType="{x:Type Separator}">
                          <Setter Property="Margin" Value="8,3"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource ThemeSeparatorBrush}"/></ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ContextMenu.Resources>
                      <MenuItem Header="Show Preview" Click="ShowHtmlPreview_Click" Visibility="Collapsed"/>
                      <MenuItem Header="Open Automatically on Server Start" IsCheckable="True"
                                Click="ToggleAutoHtmlPreview_Click" Visibility="Collapsed"/>
                      <Separator Visibility="Collapsed"/>
                      <MenuItem Header="Go to Definition" InputGestureText="F12" Click="GoToDefinition_Click"/>
                      <MenuItem Header="Go to Symbol in File" InputGestureText="Ctrl+Shift+O" Click="GoToSymbolInFile_Click"/>
                      <MenuItem Header="Find All References" InputGestureText="Shift+F12" Click="LanguageReferences_Click"/>
                      <MenuItem Header="Rename Symbol" InputGestureText="F2" Click="LanguageRename_Click"/>
                      <MenuItem Header="Code Actions" InputGestureText="Ctrl+." Click="LanguageCodeActions_Click"/>
                      <MenuItem Header="Trigger IntelliSense" InputGestureText="Ctrl+Space" Click="LanguageCompletion_Click"/>
                      <MenuItem Header="Show Hover Information" Click="LanguageHover_Click"/>
                      <Separator/>
                      <MenuItem Header="Format Document" InputGestureText="Shift+Alt+F" Click="FormatDocument_Click"/>
                    </ContextMenu>
                  </avalon:TextEditor.ContextMenu>
                </avalon:TextEditor>

                <!-- VS Code Inline Find & Replace Overlay Bar -->
                <Border x:Name="InlineFindBar" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,18,0" Background="{DynamicResource ThemePopupBrush}" BorderBrush="#4B3A93" BorderThickness="1" CornerRadius="8" Padding="10,8" Width="380">
                  <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.55" ShadowDepth="4"/>
                  </Border.Effect>
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="CloseFindBar_Click" ToolTip="Close (Esc)"/>
                      <Button DockPanel.Dock="Right" Content="↓" Width="26" Height="24" Padding="0" Margin="4,0,2,0" Click="FindNext_Click" ToolTip="Next Match (Enter)"/>
                      <Button DockPanel.Dock="Right" Content="↑" Width="26" Height="24" Padding="0" Margin="4,0,0,0" Click="FindPrev_Click" ToolTip="Previous Match (Shift+Enter)"/>
                      <CheckBox x:Name="FindMatchCaseCheck" DockPanel.Dock="Right" Content="Aa" Foreground="#C4B5FD" VerticalAlignment="Center" Margin="6,0,2,0" FontSize="10.5" Checked="FindQuery_Changed" Unchecked="FindQuery_Changed"/>
                      <TextBox x:Name="InlineFindBox" Height="26" Padding="7,2" FontSize="12" FontFamily="{StaticResource Mono}"
                               TextChanged="FindQuery_Changed" KeyDown="InlineFindBox_KeyDown" ToolTip="Find in current file"/>
                    </DockPanel>
                    <DockPanel x:Name="InlineReplaceRow" Margin="0,6,0,0" Visibility="Collapsed">
                      <Button DockPanel.Dock="Right" Content="All" Width="36" Height="24" Padding="0" Margin="4,0,0,0" FontSize="10.5" Click="ReplaceAll_Click" ToolTip="Replace All"/>
                      <Button DockPanel.Dock="Right" Content="Replace" Width="58" Height="24" Padding="0" Margin="4,0,0,0" FontSize="10.5" Click="ReplaceOne_Click" ToolTip="Replace Next"/>
                      <TextBox x:Name="InlineReplaceBox" Height="26" Padding="7,2" FontSize="12" FontFamily="{StaticResource Mono}" ToolTip="Replace with..."/>
                    </DockPanel>
                    <TextBlock x:Name="InlineFindStatus" Text="Ketik kata kunci untuk mencari di file aktif." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" Margin="2,5,0,0" FontFamily="{StaticResource Mono}"/>
                  </StackPanel>
                </Border>

                <GridSplitter x:Name="HtmlPreviewSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource ThemeSeparatorBrush}" Cursor="SizeWE" Visibility="Collapsed"/>
                <Border x:Name="HtmlPreviewHost" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource ThemePanelBrush}"
                        BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="0,0,0,0">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ThemeActivityBrush}" BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                      <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button x:Name="HtmlPreviewAnalyzeButton" Content="AI Check" Padding="7,0" Height="24" Margin="2,0"
                                  Background="#33292445" BorderBrush="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeAccentSoftBrush}"
                                  FontSize="10" Click="AnalyzeHtmlPreview_Click" ToolTip="Periksa error runtime preview dan analisis kode dengan AI"/>
                          <Button Content="↗" Width="27" Height="24" Padding="0" Margin="2,0" Click="OpenHtmlPreviewInBrowser_Click"
                                  ToolTip="Buka alamat server di browser" Visibility="Collapsed" x:Name="HtmlPreviewExternalButton"/>
                          <Button Content="⟳" Width="27" Height="24" Padding="0" Margin="2,0" Click="RefreshHtmlPreview_Click" ToolTip="Muat ulang preview"/>
                          <Button Content="✕" Width="27" Height="24" Padding="0" Margin="2,0" Click="CloseHtmlPreview_Click" ToolTip="Tutup preview"/>
                        </StackPanel>
                        <TextBlock x:Name="HtmlPreviewTitle" Text="LIVE PREVIEW" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="9.5"
                                   FontWeight="SemiBold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                    </Border>
                    <wv2:WebView2 x:Name="HtmlPreviewWebView" Grid.Row="1"/>
                  </Grid>
                </Border>

                <GridSplitter x:Name="MinimapSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeSeparatorBrush}"/>
                <Grid x:Name="MinimapPanel" Grid.Column="4" Background="{DynamicResource ThemeActivityBrush}">
                  <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="MINIMAP" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource ThemeLineNumberBrush}" Margin="7,3" HorizontalAlignment="Center"/>
                  <controls:EditorMinimap x:Name="MinimapView" Grid.Row="1" Background="{DynamicResource ThemeActivityBrush}" Foreground="{DynamicResource ThemeAccentSoftBrush}"
                                          Cursor="Hand" ToolTip="Klik untuk berpindah ke bagian kode"/>
                </Grid>

                <!-- VS Code-like welcome background: visible only while no document tab is open. -->
                <Grid x:Name="WelcomeBackground" Grid.ColumnSpan="5" Panel.ZIndex="20" Visibility="Collapsed"
                      Background="{DynamicResource ThemeEditorBrush}">
                  <StackPanel Width="500" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                      <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource ThemeSurfaceBrush}"
                              BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1" Padding="7" Margin="0,0,14,0">
                        <Image Source="pack://application:,,,/Assets/depup.png" Stretch="Uniform"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Depup Code" Foreground="{DynamicResource ThemePrimaryBrush}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="IDE untuk mengembangkan dan menerbitkan project" Foreground="{DynamicResource ThemeMutedBrush}"
                                   FontSize="11.5" Margin="1,4,0,0"/>
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Mulai bekerja" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Tag="WelcomeWorkspaceHint" Text="Pilih workspace yang sudah ada untuk mulai; file project tidak dipindahkan."
                               Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="12,0,12,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Button Content="Buka Folder" Style="{StaticResource ConfirmSecondaryButton}" Width="142" Margin="0,0,8,0"
                              Click="OpenFolder_Click" ToolTip="Pilih workspace untuk mulai mengedit (Ctrl+O)"/>
                      <Button Content="File Baru" Style="{StaticResource PrimaryButton}" Width="142" Height="34" Padding="14,0"
                              Click="HeaderNewFile_Click" ToolTip="Buat dokumen baru (Ctrl+N)"/>
                    </StackPanel>
                    <Border Margin="0,20,0,0" Padding="14,10" Background="{DynamicResource ThemePanelBrush}"
                            BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="1" CornerRadius="8">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Ctrl+P" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontFamily="{StaticResource Mono}"
                                     FontSize="10.5" FontWeight="SemiBold"/>
                          <TextBlock Text="Cari file dan workspace" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                          <TextBlock Text="Shift+Alt+F" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontFamily="{StaticResource Mono}"
                                     FontSize="10.5" FontWeight="SemiBold"/>
                          <TextBlock Text="Rapikan format kode" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Grid>
              </Grid>

              <GridSplitter x:Name="AiPanelSplitter" Grid.Column="1" Grid.RowSpan="3" Width="5"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="{DynamicResource ThemeSeparatorBrush}" ResizeDirection="Columns"
                            ResizeBehavior="PreviousAndNext" Cursor="SizeWE" Visibility="Collapsed"/>
              <Border x:Name="AiPanelBorder" Grid.Column="2" Grid.RowSpan="3"
                      Background="{DynamicResource ThemeSidebarBrush}"
                      BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <views:ChatView x:Name="AiChatViewRoot"/>
              </Border>
            </Grid>
          </ContentControl>

          <GridSplitter x:Name="BottomPanelSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{DynamicResource ThemeBorderLightBrush}" Cursor="SizeNS" ShowsPreview="True"
                        ToolTip="Tarik untuk mengatur tinggi panel terminal"/>

          <!-- Bottom Terminal Panel with Stitch AI Header & VS Code Interactive Signal Controls (Ctrl+C, Ctrl+Z, Ctrl+L) -->
          <Grid Grid.Row="2" Background="{DynamicResource ThemeTerminalBrush}">
            <TabControl x:Name="BottomTabs" Background="{DynamicResource ThemeActivityBrush}" BorderBrush="{DynamicResource ThemeSeparatorBrush}" ItemContainerStyle="{StaticResource PanelTab}">
              <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                  <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="{TemplateBinding Background}" MinHeight="32">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TabPanel Grid.Column="0" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="Transparent"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
                        <TextBlock x:Name="TerminalShellLabel" Text="PowerShell" MaxWidth="210" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Terminal shell aktif"/>
                        <Button x:Name="AnalyzeTerminalErrorButton" Content="⚠ Analisis AI" Height="24" Padding="7,0" Margin="0,0,5,0"
                                Background="#33292445" BorderBrush="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeAccentSoftBrush}"
                                FontSize="10" Click="AnalyzeTerminalError_Click" Visibility="Collapsed" ToolTip="Kirim error run terakhir ke AI chat"/>
                        <Button Style="{StaticResource IconToolbarButton}" ToolTip="New Terminal (Ctrl+Shift+`)" Click="NewTerminal_Click">
                          <TextBlock Text="＋" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconToolbarButton}" ToolTip="Hentikan proses terminal (Ctrl+C)" Click="StopTerminal_Click">
                          <Viewbox Width="11" Height="11"><Canvas Width="24" Height="24"><Rectangle Canvas.Left="4" Canvas.Top="4" Width="16" Height="16" RadiusX="2" RadiusY="2" Fill="#F87171"/></Canvas></Viewbox>
                        </Button>
                        <Button Style="{StaticResource IconToolbarButton}" ToolTip="Mulai ulang sesi PowerShell di folder workspace" Click="RestartTerminal_Click">
                          <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M20,11 A8,8 0 1,0 19,16 M20,4 L20,11 L13,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        </Button>
                        <Button Style="{StaticResource IconToolbarButton}" ToolTip="Close active terminal" Click="CloseTerminal_Click">
                          <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M3,6 L21,6 M8,6 L8,4 C8,2.9 8.9,2 10,2 L14,2 C15.1,2 16,2.9 16,4 L16,6 M19,6 L18,20 C18,21.1 17.1,22 16,22 L8,22 C6.9,22 6,21.1 6,20 L5,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        </Button>
                        <Button Style="{StaticResource IconToolbarButton}" ToolTip="Sembunyikan atau tampilkan panel terminal (Ctrl+`)" Click="ToggleBottomPanel_Click">
                          <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6,9 L12,15 L18,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        </Button>
                      </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                      <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                  </Grid>
                </ControlTemplate>
              </TabControl.Template>
              <TabItem Header="TERMINAL  ●">
                <Grid Background="{DynamicResource ThemeTerminalBrush}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="154"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="38"/>
                  </Grid.RowDefinitions>

                  <!-- Terminal Output Console (Supports Ctrl+C, Ctrl+Z, Ctrl+L, Direct Typing) -->
                  <TextBox x:Name="TerminalOutput" Grid.Row="0" Grid.Column="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                           Background="{DynamicResource ThemeTerminalBrush}" BorderThickness="0" FontFamily="{StaticResource Mono}" FontSize="12"
                           Padding="14,8" Foreground="{DynamicResource ThemeSoftBrush}" CaretBrush="#A855F7" SelectionBrush="{DynamicResource ThemeAccentHoverBrush}"
                           PreviewKeyDown="TerminalOutput_PreviewKeyDown"/>

                  <ListBox x:Name="TerminalSessionsList" Grid.Row="0" Grid.Column="1" Margin="0,4,5,4" Padding="3"
                           Background="{DynamicResource ThemeActivityBrush}" BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="1"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="TerminalSessionsList_SelectionChanged"
                           ToolTip="Sesi terminal aktif">
                    <ListBox.Resources>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryBrush}"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="1,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="SessionItemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="7,6">
                                <ContentPresenter/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="SessionItemBorder" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="SessionItemBorder" Property="Background" Value="{DynamicResource ThemeActiveNavBrush}"/>
                                  <Setter TargetName="SessionItemBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                  <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&gt;_" Foreground="{DynamicResource ThemeAccentSoftBrush}" FontFamily="{StaticResource Mono}" FontSize="10" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontFamily="{StaticResource Mono}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Text="{Binding DirectoryName}" Foreground="{DynamicResource ThemeDimBrush}" FontSize="8.5" Margin="18,3,0,0"
                                     TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkingDirectory}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- Interactive Command Bar matching Stitch AI + Stop (Ctrl+C) & Clear Controls -->
                  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource ThemeActivityBrush}" BorderBrush="#231B42" BorderThickness="0,1,0,0" Padding="12,0">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="TerminalPromptText" Grid.Column="0" Text="PS&gt;" MaxWidth="280" TextTrimming="CharacterEllipsis"
                                 Foreground="#C084FC" FontWeight="Bold" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBox x:Name="TerminalInput" Grid.Column="1"
                               PreviewKeyDown="TerminalInput_PreviewKeyDown"
                               Background="{DynamicResource ThemeInputBrush}" Height="27" Padding="9,3" MinWidth="120"
                               VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" FontSize="11.5"
                               BorderBrush="{DynamicResource ThemeButtonSurfaceBrush}" BorderThickness="1" Foreground="{DynamicResource ThemePrimaryBrush}" CaretBrush="#C084FC" SelectionBrush="{DynamicResource ThemeAccentHoverBrush}"
                               TextWrapping="NoWrap" AcceptsReturn="False" Text=""
                               ToolTip="Ketik perintah lalu Enter • Ctrl+C: Hentikan proses (npm run dev) • Ctrl+Z: Suspend • Ctrl+L: Clear • Tab: Autocomplete"/>
                      <Button Grid.Column="2" Content="▶ Run Command" Style="{StaticResource PrimaryButton}" Height="26" Padding="11,0" Margin="8,0,0,0" FontSize="11" Click="RunTerminal_Click" ToolTip="Jalankan perintah (Enter)"/>
                      <Button Grid.Column="3" Content="⏹ Ctrl+C" Background="#2A1528" BorderBrush="#6E2549" Foreground="#FDA4AF" Height="26" Padding="9,0" Margin="5,0,0,0" FontSize="10.5" Click="StopTerminal_Click" ToolTip="Kirim sinyal Interrupt Ctrl+C untuk menghentikan proses yang berjalan (seperti npm run dev)"/>
                      <Button Grid.Column="4" Content="Clear" Background="#18122E" BorderBrush="#2E2459" Foreground="{DynamicResource ThemeSecondaryBrush}" Height="26" Padding="9,0" Margin="5,0,0,0" FontSize="10.5" Click="ClearTerminal_Click" ToolTip="Bersihkan layar terminal (Ctrl+L)"/>
                    </Grid>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem x:Name="DebugTabItem" Header="RUN &amp; DEBUG">
                <Grid Background="{DynamicResource ThemeTerminalBrush}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Padding="8,5" Background="{DynamicResource ThemeActivityBrush}"
                          BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                      <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Content="▶ Start / Continue" Padding="8,4" Margin="0,0,5,0" Click="StartOrContinueDebugging_Click" ToolTip="F5"/>
                        <Button Content="F9 Breakpoint" Padding="8,4" Margin="0,0,5,0" Click="ToggleBreakpoint_Click" ToolTip="Pasang atau hapus breakpoint pada baris aktif"/>
                        <Button Content="Step Over" Padding="8,4" Margin="0,0,5,0" Click="DebugStepOver_Click" ToolTip="F10"/>
                        <Button Content="Step Into" Padding="8,4" Margin="0,0,5,0" Click="DebugStepInto_Click" ToolTip="F11"/>
                        <Button Content="Step Out" Padding="8,4" Margin="0,0,5,0" Click="DebugStepOut_Click" ToolTip="Shift+F11"/>
                        <Button Content="⏸ Pause" Padding="8,4" Margin="0,0,5,0" Click="DebugPause_Click"/>
                        <Button Content="■ Stop" Padding="8,4" Click="StopDebugging_Click" ToolTip="Shift+F5"/>
                      </WrapPanel>
                      <Button x:Name="AnalyzeDebugErrorButton" DockPanel.Dock="Right" Content="⚠ Analisis AI" Padding="8,4"
                              Margin="8,0,0,0" Click="AnalyzeDebugError_Click" Visibility="Collapsed"
                              ToolTip="Kirim error debug terakhir ke AI untuk analisis"/>
                      <TextBlock x:Name="DebugStatusText" Text="Belum ada sesi debug · F5 untuk setup atau mulai"
                                 Foreground="{DynamicResource ThemeSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                 TextTrimming="CharacterEllipsis" ToolTip="Status debug adapter"/>
                    </DockPanel>
                  </Border>
                  <TabControl Grid.Row="1" Background="{DynamicResource ThemeActivityBrush}" BorderBrush="{DynamicResource ThemeSeparatorBrush}"
                              ItemContainerStyle="{StaticResource PanelTab}">
                    <TabItem Header="CALL STACK">
                      <ListBox x:Name="DebugStackList" Background="{DynamicResource ThemeTerminalBrush}" BorderThickness="0"
                               Foreground="{DynamicResource ThemePrimaryBrush}" FontFamily="{StaticResource Mono}" FontSize="11"
                               MouseDoubleClick="DebugStackList_MouseDoubleClick" ToolTip="Klik ganda frame untuk membuka sumbernya"/>
                    </TabItem>
                    <TabItem Header="VARIABLES">
                      <ListBox x:Name="DebugVariablesList" Background="{DynamicResource ThemeTerminalBrush}" BorderThickness="0"
                               Foreground="{DynamicResource ThemePrimaryBrush}" FontFamily="{StaticResource Mono}" FontSize="11"/>
                    </TabItem>
                    <TabItem Header="BREAKPOINTS">
                      <ListBox x:Name="DebugBreakpointsList" Background="{DynamicResource ThemeTerminalBrush}" BorderThickness="0"
                               Foreground="{DynamicResource ThemePrimaryBrush}" FontFamily="{StaticResource Mono}" FontSize="11"
                               MouseDoubleClick="DebugBreakpointsList_MouseDoubleClick" ToolTip="Klik ganda breakpoint untuk membuka barisnya"/>
                    </TabItem>
                    <TabItem x:Name="DebugTerminalTabItem" Header="TERMINAL">
                      <wv2:WebView2 x:Name="DebugTerminalWebView" ToolTip="Windows ConPTY · xterm.js · input, Unicode, warna, TUI, mouse, dan resize"/>
                    </TabItem>
                    <TabItem x:Name="DebugConsoleTabItem" Header="DEBUG CONSOLE">
                      <TextBox x:Name="DebugConsoleText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                               VerticalScrollBarVisibility="Auto" Background="{DynamicResource ThemeTerminalBrush}" BorderThickness="0"
                               FontFamily="{StaticResource Mono}" FontSize="11" Padding="10,7" Foreground="{DynamicResource ThemeSoftBrush}"/>
                    </TabItem>
                  </TabControl>
                </Grid>
              </TabItem>
              <TabItem Header="OUTPUT">
                <TextBox x:Name="OutputLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource ThemeTerminalBrush}" BorderThickness="0" FontFamily="{StaticResource Mono}" FontSize="11.5" Padding="12,8" Foreground="{DynamicResource ThemeSecondaryBrush}"/>
              </TabItem>
              <TabItem x:Name="ProblemsTabItem" Header="PROBLEMS  0">
                <Grid Background="{DynamicResource ThemeTerminalBrush}">
                  <ListBox x:Name="ProblemsList" Background="{DynamicResource ThemeTerminalBrush}" BorderThickness="0" Foreground="{DynamicResource ThemePrimaryBrush}"
                           FontFamily="{StaticResource Mono}" FontSize="11.5" Padding="8,6" SelectionChanged="ProblemsList_SelectionChanged"/>
                  <TextBlock x:Name="ProblemsEmptyText" Text="✓ Tidak ada masalah sintaks atau konfigurasi yang terdeteksi di workspace."
                             Foreground="{DynamicResource ThemeDimBrush}" FontFamily="{StaticResource Mono}" FontSize="11.5" Margin="14,12" IsHitTestVisible="False"/>
                </Grid>
              </TabItem>
              <TabItem Header="☁ DEPUP LOGS">
                <TextBox x:Name="DepupLogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource ThemeTerminalBrush}" BorderThickness="0" FontFamily="{StaticResource Mono}" FontSize="11.5" Padding="12,8" Foreground="#C4B5FD"/>
              </TabItem>
            </TabControl>

          </Grid>
        </Grid>
      </Grid>

      <!-- Compact status bar -->
      <Border Grid.Row="2" Background="{DynamicResource ThemeStatusBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="10,0">
          <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="GitStatusText" Grid.Column="0" Text="⑂ main" Foreground="#D4D4D8" VerticalAlignment="Center"
                     Margin="2,0,14,0" FontSize="10.5" FontFamily="{StaticResource Mono}" Cursor="Hand" MouseLeftButtonUp="StatusBarGit_Click" ToolTip="Klik untuk membuka Source Control"/>

          <Ellipse x:Name="StatusBarTunnelDot" Grid.Column="1" Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock x:Name="TunnelStatusText" Grid.Column="2" Text="Link Gaib: Idle" Foreground="{DynamicResource ThemeMutedBrush}"
                     VerticalAlignment="Center" FontSize="10.5" FontFamily="{StaticResource Mono}" Cursor="Hand"
                     MouseLeftButtonUp="StatusBarTunnel_Click" Margin="0,0,16,0" ToolTip="Klik untuk mengelola Link Gaib Tunnel"/>

          <Ellipse x:Name="StatusBarPhpDot" Grid.Column="3" Width="6" Height="6" Fill="#6C6794" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock x:Name="PhpStatusText" Grid.Column="4" Text="PHP: Off" Foreground="{DynamicResource ThemeMutedBrush}"
                     VerticalAlignment="Center" FontSize="10.5" FontFamily="{StaticResource Mono}" Cursor="Hand"
                     MouseLeftButtonUp="StatusBarPhp_Click" Margin="0,0,16,0" ToolTip="Klik untuk menjalankan atau menghentikan server PHP lokal"/>

          <TextBlock x:Name="ProjectsCountStatusText" Grid.Column="5" Text="❐ 0 Projects Cached" Foreground="{DynamicResource ThemeMutedBrush}"
                     VerticalAlignment="Center" FontSize="10.5" Cursor="Hand" MouseLeftButtonUp="HeaderProjects_Click" ToolTip="Klik untuk membuka Projects &amp; Workspaces"/>

          <TextBlock x:Name="DepupCloudText" Grid.Column="6" Text="Checking Depup Cloud…" Foreground="{DynamicResource ThemeAccentSoftBrush}" VerticalAlignment="Center" Margin="14,0" FontSize="10" TextTrimming="CharacterEllipsis"/>

          <TextBlock x:Name="StatusLineText" Grid.Column="7" Text="Ln 1, Col 1" Foreground="{DynamicResource ThemeMutedBrush}" VerticalAlignment="Center" Margin="6,0" FontSize="10.5" FontFamily="{StaticResource Mono}" Cursor="Hand" MouseLeftButtonUp="HeaderGoToLine_Click"/>
          <TextBlock x:Name="ZoomStatusText" Grid.Column="8" Text="🔍 100%" Foreground="#C4B5FD" VerticalAlignment="Center" Margin="6,0" FontSize="10.5" FontFamily="{StaticResource Mono}" Cursor="Hand" MouseLeftButtonUp="ZoomReset_Click" ToolTip="Zoom Level (Ctrl+= Zoom In, Ctrl+- Zoom Out, Klik atau Ctrl+0 untuk Reset)"/>
          <TextBlock x:Name="EncodingStatusText" Grid.Column="9" Text="UTF-8" Foreground="{DynamicResource ThemeMutedBrush}" VerticalAlignment="Center" Margin="6,0" FontSize="10.5" FontFamily="{StaticResource Mono}"/>
          <TextBlock x:Name="LanguageStatusText" Grid.Column="10" Text="TypeScript JSX" Foreground="{DynamicResource ThemeAccentSoftBrush}" VerticalAlignment="Center" Margin="6,0" FontSize="10.5" FontFamily="{StaticResource Mono}"
                     Cursor="Hand" MouseLeftButtonUp="LanguageStatus_Click"/>
          <TextBlock x:Name="PrettierStatusButton" Grid.Column="11" Text="✓ Format" Foreground="#34D399" VerticalAlignment="Center" Margin="6,0" FontSize="10.5"
                     Cursor="Hand" MouseLeftButtonUp="FormatDocument_Click" ToolTip="Format otomatis sesuai tipe file (Shift+Alt+F)"/>

          <!-- Status-only footer; account and settings live at the bottom of the activity bar. -->
          <Button x:Name="OfflineModeToggleButton" Grid.Column="12" Content="🟢 Mode: Online" Padding="8,2" Margin="6,0,4,0" Height="22" FontSize="10"
                  Background="#0F2A22" BorderBrush="#1E5A45" Foreground="#34D399" Click="ToggleOfflineMode_Click" ToolTip="Switch antara Online Mode (Live Fetch) dan Offline Mode (Local Cache)"/>
        </Grid>
      </Border>

      <!-- In-app confirmation overlay to keep destructive actions inside the DepupCode window. -->
      <Grid x:Name="DeleteConfirmationOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000"
            Visibility="Collapsed" Background="#99070A12" Focusable="True"
            PreviewKeyDown="DeleteConfirmationOverlay_PreviewKeyDown">
        <Border Width="430" MaxHeight="260" Margin="20" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource ThemePopupBrush}" BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                BorderThickness="1" CornerRadius="12">
          <Border.Effect>
            <DropShadowEffect Color="#05030C" BlurRadius="28" ShadowDepth="8" Opacity="0.48"/>
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,17">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
              </Grid.ColumnDefinitions>
              <Border Width="36" Height="36" CornerRadius="10" Background="#2A1720" BorderBrush="#653043" BorderThickness="1">
                <TextBlock Text="!" Foreground="#FB7185" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Konfirmasi penghapusan" Foreground="{DynamicResource ThemePrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="Tindakan ini tidak dapat dibatalkan" Foreground="{DynamicResource ThemeDimBrush}"
                           FontSize="10" Margin="0,3,0,0"/>
              </StackPanel>
              <Button Grid.Column="2" Content="×" Width="28" Height="28" Padding="0" FontSize="18"
                      Style="{StaticResource IconToolbarButton}" Click="DeleteConfirmationCancel_Click"
                      ToolTip="Tutup konfirmasi" VerticalAlignment="Top"/>
            </Grid>
            <TextBlock x:Name="DeleteConfirmationMessage" Grid.Row="1" Foreground="{DynamicResource ThemeSoftBrush}"
                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Border Grid.Row="2" Margin="0,12,0,18" Padding="10,8" CornerRadius="6"
                    Background="#25131D" BorderBrush="#512638" BorderThickness="1">
              <TextBlock x:Name="DeleteConfirmationDetails" Foreground="#E6A7B2" FontSize="10.5"
                         TextWrapping="Wrap"/>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="DeleteConfirmationCancelButton" Content="Batal" Style="{StaticResource ConfirmSecondaryButton}"
                      Margin="0,0,8,0" Click="DeleteConfirmationCancel_Click"/>
              <Button Content="Hapus Permanen" Style="{StaticResource ConfirmDangerButton}"
                      Click="DeleteConfirmationConfirm_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
