                  <TextBlock Text="⌕" Foreground="{DynamicResource ThemeDimBrush}" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <TextBlock Text="Cari variabel…" Foreground="{DynamicResource ThemeDimBrush}" FontSize="10.5" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=EnvironmentSidebarSearchBox}" Value="">
